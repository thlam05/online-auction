{{#section "js"}}
<script>

    const recoveryForm = document.querySelector("#recoveryForm");
    recoveryForm.onsubmit = (e) => {
        e.preventDefault();

        const newPassword = recoveryForm.querySelector("#input-new-password");
        const confirmPassword = recoveryForm.querySelector("#input-confirm-password");

        newPassword.classList.remove("invalid");
        confirmPassword.classList.remove("invalid");

        let isValid = true;
        if (newPassword.value == "") {
            newPassword.classList.add("invalid");
            isValid = false;
        }
        if (confirmPassword.value == "") {
            confirmPassword.classList.add("invalid");
            isValid = false;
        }

        if (!isValid) return;

        recoveryForm.submit();
    }

</script>
{{/section}}

<div class="d-flex justify-content-center" style="margin-top: 200px; margin-bottom: 200px;">

    <div class="col-5">
        <p class="text fs-5">{{message}}</p>
        {{#if error}}
        <p class="text-danger">{{errorMessage}}</p>
        {{/if}}
        <form action="/auth/recovery-password" method="POST" id="recoveryForm">
            <div class="mb-3">
                <label for="input-new-password" class="form-label">New password</label>
                <input type="text" class="form-control" id="input-new-password" name="password">
            </div>
            <div class="mb-3">
                <label for="input-confirm-password" class="form-label">Confirm password</label>
                <input type="text" class="form-control" id="input-confirm-password">
            </div>
            <input type="hidden" class="form-control" name="userId" value="{{userId}}">
            <button type="submit" class="btn btn-primary">Change password</button>
        </form>
    </div>
</div>