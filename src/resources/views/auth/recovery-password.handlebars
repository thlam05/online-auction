{{#section "js"}}
<script>
    const recoveryForm = document.querySelector("#recoveryForm");
    recoveryForm.onsubmit = (e) => {
        e.preventDefault();

        const newPassword = recoveryForm.querySelector("#input-new-password");
        const confirmPassword = recoveryForm.querySelector("#input-confirm-password");

        newPassword.classList.remove("border-red-500");
        confirmPassword.classList.remove("border-red-500");
        newPassword.classList.add("border-gray-300");
        confirmPassword.classList.add("border-gray-300");

        let isValid = true;
        if (newPassword.value == "") {
            newPassword.classList.remove("border-gray-300");
            newPassword.classList.add("border-red-500");
            isValid = false;
        }
        if (confirmPassword.value == "") {
            confirmPassword.classList.remove("border-gray-300");
            confirmPassword.classList.add("border-red-500");
            isValid = false;
        }
        if (newPassword.value !== confirmPassword.value) {
            confirmPassword.classList.remove("border-gray-300");
            confirmPassword.classList.add("border-red-500");
            isValid = false;
        }

        if (!isValid) return;

        recoveryForm.submit();
    }
</script>
{{/section}}

<div class="min-h-[60vh] flex items-center justify-center py-12 px-4">
    <div class="w-full max-w-md">
        <div class="bg-white rounded-2xl shadow-lg border border-gray-100 p-8">
            <div class="text-center mb-6">
                <div class="w-16 h-16 bg-primary-50 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z">
                        </path>
                    </svg>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">Đặt lại mật khẩu</h2>
                <p class="text-gray-500 mt-2">{{message}}</p>
            </div>

            {{#if error}}
            <div class="bg-red-50 border border-red-200 text-red-600 px-4 py-3 rounded-xl mb-6">
                {{errorMessage}}
            </div>
            {{/if}}

            <form action="/auth/recovery-password" method="POST" id="recoveryForm">
                <div class="mb-4">
                    <label for="input-new-password" class="block text-sm font-medium text-gray-700 mb-2">Mật khẩu
                        mới</label>
                    <input type="password"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="input-new-password" name="password" placeholder="••••••••">
                </div>
                <div class="mb-6">
                    <label for="input-confirm-password" class="block text-sm font-medium text-gray-700 mb-2">Xác nhận
                        mật khẩu</label>
                    <input type="password"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="input-confirm-password" placeholder="••••••••">
                </div>
                <input type="hidden" name="userId" value="{{userId}}">
                <button type="submit"
                    class="w-full py-3 bg-primary-500 hover:bg-primary-600 text-white font-semibold rounded-xl transition">
                    Đổi mật khẩu
                </button>
            </form>

            <div class="text-center mt-6">
                <a href="/auth/signin" class="text-primary-500 hover:text-primary-600 font-medium">
                    ← Quay lại đăng nhập
                </a>
            </div>
        </div>
    </div>
</div>