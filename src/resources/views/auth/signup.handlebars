{{#section "js"}}
<script>
    const showPasswordBtn = document.querySelector(".show-password-btn");
    const inputPassword = document.querySelector("#signup-password");
    const showPasswordConfirmBtn = document.querySelector(".show-password-confirm-btn");
    const inputPasswordConfirm = document.querySelector("#signup-password-confirm");

    function togglePassword(input, btn) {
        if (input.type == "password") {
            input.type = "text";
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59m0 0A9.953 9.953 0 0112 5c4.478 0 8.268 2.943 9.543 7a10.025 10.025 0 01-4.132 5.411m0 0L21 21"/></svg>';
        } else {
            input.type = "password";
            btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>';
        }
    }

    showPasswordBtn.onclick = function (event) {
        event.preventDefault();
        togglePassword(inputPassword, showPasswordBtn);
    }

    showPasswordConfirmBtn.onclick = function (event) {
        event.preventDefault();
        togglePassword(inputPasswordConfirm, showPasswordConfirmBtn);
    }

    const emailMessage = document.querySelector(".signup-email-message");
    const emailInput = document.querySelector("#signup-email");
    if (emailInput && emailMessage) {
        emailInput.oninput = function (event) {
            emailMessage.innerText = "";
        }
    }

    // reCAPTCHA v3
    const signupForm = document.querySelector("#signup-form");
    if (signupForm) {
        signupForm.addEventListener("submit", function (event) {
            event.preventDefault();
            grecaptcha.ready(function () {
                grecaptcha.execute('{{RECAPTCHA_SITE_KEY}}', { action: 'signup' }).then(function (token) {
                    // Thêm token vào form
                    const input = document.createElement('input');
                    input.type = 'hidden';
                    input.name = 'g-recaptcha-response';
                    input.value = token;
                    signupForm.appendChild(input);
                    // Submit form
                    signupForm.submit();
                });
            });
        });
    }
</script>
{{/section}}

{{#> auth-container navigationLink="/auth/signin" navigationText="Đăng nhập →"}}
<!-- Header -->
<div class="text-center space-y-2">
    <h1 class="text-2xl font-semibold tracking-tight">Tạo tài khoản</h1>
    <p class="text-sm text-muted-foreground">Nhập thông tin bên dưới để tạo tài khoản</p>
</div>

{{#if error}}
<div class="alert alert-destructive flex items-center gap-2 text-sm">
    <svg class="w-4 h-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <circle cx="12" cy="12" r="10" />
        <line x1="12" y1="8" x2="12" y2="12" />
        <line x1="12" y1="16" x2="12.01" y2="16" />
    </svg>
    <span class="signup-email-message">{{message}}</span>
</div>
{{/if}}

<form id="signup-form" action="/auth/signup" method="POST" class="space-y-4">
    <!-- Email -->
    <div class="space-y-2">
        <label for="signup-email" class="text-sm font-medium">Email</label>
        <input type="email" class="form-input" id="signup-email" name="email" value="{{data.email}}"
            placeholder="name@example.com" required>
    </div>

    <!-- Username -->
    <div class="space-y-2">
        <label for="signup-username" class="text-sm font-medium">Họ và tên</label>
        <input type="text" class="form-input" id="signup-username" name="username" value="{{data.username}}"
            placeholder="Nguyễn Văn A" required>
    </div>

    <!-- Address -->
    <div class="space-y-2">
        <label for="signup-address" class="text-sm font-medium">Địa chỉ</label>
        <input type="text" class="form-input" id="signup-address" name="address" value="{{data.address}}"
            placeholder="123 Nguyễn Văn Cừ, Q.5, TP.HCM">
    </div>

    <!-- Birthday -->
    <div class="space-y-2">
        <label for="signup-birthday" class="text-sm font-medium">Ngày sinh</label>
        <input type="date" class="form-input" id="signup-birthday" name="birthday" value="{{data.birthday}}">
    </div>

    <!-- Password -->
    <div class="space-y-2">
        <label for="signup-password" class="text-sm font-medium">Mật khẩu</label>
        <div class="relative">
            <input type="password" class="form-input pr-10" id="signup-password" name="password"
                value="{{data.password}}" placeholder="••••••••" required>
            <button type="button"
                class="show-password-btn absolute right-0 top-0 h-full px-3 text-muted-foreground hover:text-foreground">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </button>
        </div>
    </div>

    <!-- Password confirm -->
    <div class="space-y-2">
        <label for="signup-password-confirm" class="text-sm font-medium">Xác nhận mật khẩu</label>
        <div class="relative">
            <input type="password" class="form-input pr-10" id="signup-password-confirm" name="passwordConfirm"
                placeholder="••••••••" required>
            <button type="button"
                class="show-password-confirm-btn absolute right-0 top-0 h-full px-3 text-muted-foreground hover:text-foreground">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
            </button>
        </div>
    </div>

    <button type="submit" class="btn-primary w-full">
        Đăng ký với Email
    </button>
</form>

<!-- reCAPTCHA v3 -->
<script src="https://www.google.com/recaptcha/api.js?render={{RECAPTCHA_SITE_KEY}}"></script>

<!-- Divider -->
<div class="relative">
    <div class="absolute inset-0 flex items-center">
        <span class="w-full border-t"></span>
    </div>
    <div class="relative flex justify-center text-xs uppercase">
        <span class="bg-background px-2 text-muted-foreground">Hoặc tiếp tục với</span>
    </div>
</div>

<!-- Social login -->
<div class="grid grid-cols-2 gap-3">
    <a href="/auth/google" class="btn-outline h-10">
        <svg class="w-4 h-4" viewBox="0 0 24 24">
            <path fill="#4285F4"
                d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853"
                d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05"
                d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" />
            <path fill="#EA4335"
                d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" />
        </svg>
        Google
    </a>
    <a href="/auth/facebook" class="btn-outline h-10">
        <svg class="w-4 h-4 text-[#1877F2]" fill="currentColor" viewBox="0 0 24 24">
            <path
                d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
        </svg>
        Facebook
    </a>
</div>

<!-- Terms -->
<p class="px-8 text-center text-sm text-muted-foreground">
    Bằng việc tiếp tục, bạn đồng ý với
    <a href="#" class="underline underline-offset-4 hover:text-primary-500">Điều khoản dịch vụ</a>
    và
    <a href="#" class="underline underline-offset-4 hover:text-primary-500">Chính sách bảo mật</a>.
</p>
{{/auth-container}}