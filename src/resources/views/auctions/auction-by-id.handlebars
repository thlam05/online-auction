{{#section "js"}}
<script>
    const remaininTimes = document.querySelector(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "It's over.";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days}d: `;
            if (hours > 0) str += ` ${hours}h: `;
            if (minutes > 0) str += ` ${minutes}m`;
            return str;
        }

        let str = "";
        if (hours > 0) str += `${hours}h: `;
        if (minutes > 0) str += `${minutes}m: `;
        str += `${seconds}s`;

        return str.trim();
    }

    function updateRemainingTime() {
        const end = new Date(remaininTimes.getAttribute("data-end-time"));
        const now = new Date();
        const diff = end - now;
        remaininTimes.textContent = formatRemainingTime(diff);
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    const auction = document.querySelector(".auction");
    function redirect() {
        window.location.href = "/auth/signin";
    }

    function extractNumber(str) {
        return Number(str.replace(/\D/g, ""));
    }

    const auctionCurPriceElement = document.querySelector(".auction-current-price");
    const auctionBidStepElement = document.querySelector(".auction-bid-step");

    const auctionCurPrice = extractNumber(auctionCurPriceElement.innerText);
    const auctionBidStep = extractNumber(auctionBidStepElement.innerText);

    const formPostBid = document.querySelector("#form-post-bid");
    formPostBid.onsubmit = function (event) {
        event.preventDefault();

        const bidPrice = formPostBid.querySelector(".form-control");

        bidPrice.oninput = function () {
            bidPrice.classList.remove("invalid");
        }

        if (+bidPrice.value < auctionCurPrice + auctionBidStep) {
            bidPrice.classList.add("invalid");
            return;
        }

        formPostBid.submit();
    }

    const formSendMessage = document.querySelector("#form-send-message");
    formSendMessage.onsubmit = function (event) {
        event.preventDefault();

        const input = formSendMessage.querySelector(".form-control");
        input.oninput = function (event) {
            input.classList.remove("invalid");
        }
        if (input.value == "") {
            input.classList.add("invalid");
            return;
        }

        formSendMessage.submit();
    }

    const btnAddWatchlist = document.querySelector("#btn-add-watchlist");
    btnAddWatchlist.onclick = async function () {
        const auction_id = this.dataset.auctionId;

        try {
            const res = await fetch("/watch-list/add", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({ auction_id })
            });

            if (!res.ok) {
                throw new Error("Request failed");
            }

            const data = await res.json();
        } catch (err) {
            console.error(err);
            alert("Không thể thêm vào watchlist");
        }
    }
</script>
{{/section}}

<div class="row row-cols-2 py-4">
    <div class="col col-7">
        <div class="row mb-3">
            <div class="col">
                <img src="{{auction.mainImage.url}}" class="img-fluid w-100 rounded" alt=""
                    style="height: 500px; object-fit: contain;">
            </div>
        </div>

        <div class="row row-cols-3 g-2">
            {{#each auction.subImages}}
            <div class="col">
                <img src="{{this.url}}" class="img-fluid w-100 rounded" alt="" style="object-fit: contain;">
            </div>
            {{/each}}
        </div>
    </div>

    <div class="col col-5 auction">
        <h2 class="p-3">{{auction.name}}</h2>
        <div class="card ">
            <div class="card-body">
                <div class="border-left border-warning remaining-time-auction">
                    <p class="title">Auction ends in</p>
                    <p class="remaining-time" data-end-time="{{auction.end_at}}">02d : 18h : 45m : 33s</p>
                    <p>Ends: {{formatDate auction.end_at}}</p>
                </div>

                <div class="ps-2">
                    <p>Posted: {{formatDate auction.start_at}}</p>
                </div>

                <div class="row row-cols-3 p-3">
                    <div class="col d-flex flex-column text-center">
                        <span class="text-secondary small">Current bid</span>
                        <span class="fw-semibold auction-current-price">{{formatNumber
                            auction.current_price}}<sup>đ</sup></span>
                    </div>

                    <div class="col d-flex flex-column text-center">
                        <span class="text-secondary small">Price step</span>
                        <span class="fw-semibold auction-bid-step">{{formatNumber
                            auction.bid_step}}<sup>đ</sup></span>
                    </div>

                    <div class="col d-flex flex-column text-center">
                        <span class="text-secondary small">Buy now price</span>
                        <span class="fw-semibold">{{formatNumber auction.buy_now_price}}<sup>đ</sup></span>
                    </div>
                </div>

                <div class="">
                    <div
                        class="d-flex justify-content-between align-items-center bg-light pt-1 pb-1 ps-3 pe-3 mt-2 border border-gray rounded">
                        <div class="d-flex flex-column">
                            <span style="font-size: 12px;">Seller</span>
                            <span>{{auction.seller.username}}</span>
                        </div>
                        <span>4.9</span>
                    </div>

                    <div
                        class="d-flex justify-content-between align-items-center bg-light pt-1 pb-1 ps-3 pe-3 mt-2 border border-gray rounded">
                        <div class="d-flex flex-column">
                            <span style="font-size: 12px;">Highest bibber</span>
                            <span>{{auction.highestBidder.username}}</span>
                        </div>
                        <span>4.9</span>
                    </div>
                </div>

                <div class="pt-2 mt-4 border-top border-gray">
                    <form action="/auctions/{{auction.id}}/bids" method="POST" class="form" id="form-post-bid">
                        <input type="number" class="form-control mb-2" placeholder="Enter your bib" name="max_price">
                        <button class="btn btn-primary w-100">
                            Place bid
                        </button>
                    </form>
                    <div class="d-flex">
                        <button class="btn btn-outline-primary w-100 mt-2 me-2" {{#unless
                            isAuthenticated}}onclick="redirect()" {{/unless}}>Buy now</button>
                        <button id="btn-add-watchlist" class="btn btn-outline-secondary w-100 mt-2 ms-2" {{#unless
                            isAuthenticated}}onclick="redirect()" {{/unless}} data-auction-id="{{auction.id}}">Add to
                            Watch List</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>




<div class="py-4">
    <ul class="nav nav-tabs mb-4">
        <li class="nav-item">
            <a class="nav-link active" data-bs-toggle="tab" href="#description">Description</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#qa">Q&A</a>
        </li>
        <li class="nav-item">
            <a class="nav-link" data-bs-toggle="tab" href="#related">Related Items</a>
        </li>
    </ul>



    <div class="tab-content">

        <div class="tab-pane fade show active" id="description">
            {{{auction.description}}}
        </div>

        <div class="tab-pane fade" id="qa">
            <h4>Q&A</h4>

            <div class="card my-3 ">
                <form id="form-send-message" action="/auctions/{{auction.id}}/messages" method="POST" class="form p-3">
                    <textarea class="form-control" placeholder="Leave questions here" id="floatingTextarea"
                        name="content"></textarea>
                    <button class="btn btn-outline-secondary mt-2">Send to seller</button>
                </form>
            </div>

            {{#each messages}}
            <div class="card mb-2">
                <div class="card-body">

                    <!-- Header -->
                    <div class="d-flex align-items-center">
                        <div class="ms-2 d-flex">
                            <div class="fw-semibold">
                                {{this.sender_name}}
                            </div>
                            <p class="text-muted ms-5">
                                {{formatDate this.created_at}}
                            </p>
                        </div>
                    </div>

                    <!-- Content -->
                    <p class="card-text ms-5 mb-2">
                        {{this.content}}
                    </p>

                    <!-- Replies -->
                    {{#if this.replyMessages.length}}
                    <div class="ms-5 mt-3">
                        {{#each this.replyMessages}}
                        <div class="border-start border-3 border-primary ps-3 mb-3">

                            <div class="d-flex align-items-center mb-1">
                                <span class="badge bg-primary me-2">
                                    Seller
                                </span>
                                <strong>{{this.sender_name}}</strong>
                                <small class="text-muted ms-2">
                                    {{this.created_at}}
                                </small>
                            </div>

                            <p class="mb-1">
                                {{this.content}}
                            </p>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}

                </div>
            </div>
            {{/each}}
        </div>

        <div class="tab-pane fade" id="related">
            <h4 class="mt-4">Related Items</h4>
            <div class="row g-3">

                <div class="col-md-3">
                    <div class="card h-100">
                        {{!-- <img src="https://via.placeholder.com/300x200" class="card-img-top" alt="Turntable"> --}}
                        <div class="card-body">
                            <h6 class="card-title">Vintage Turntable</h6>
                            <p class="text-primary fw-bold">$225.50</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card h-100">
                        {{!-- <img src="https://via.placeholder.com/300x200" class="card-img-top"
                            alt="Bookshelf Speakers"> --}}
                        <div class="card-body">
                            <h6 class="card-title">Bookshelf Speakers</h6>
                            <p class="text-primary fw-bold">$150.00</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card h-100">
                        {{!-- <img src="https://via.placeholder.com/300x200" class="card-img-top"
                            alt="Reel-to-Reel Deck"> --}}
                        <div class="card-body">
                            <h6 class="card-title">Reel-to-Reel Deck</h6>
                            <p class="text-primary fw-bold">$480.00</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <div class="card h-100">
                        {{!-- <img src="https://via.placeholder.com/300x200" class="card-img-top" alt="Cassette Deck">
                        --}}
                        <div class="card-body">
                            <h6 class="card-title">Cassette Deck</h6>
                            <p class="text-primary fw-bold">$95.00</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>