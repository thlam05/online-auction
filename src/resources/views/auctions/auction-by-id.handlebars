{{#section "js"}}
<script src="/js/shared/currency-formatter.js"></script>
<script>
    const remaininTimes = document.querySelector(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days} ngày `;
            if (hours > 0) str += ` ${hours} giờ `;
            if (minutes > 0) str += ` ${minutes} phút`;
            return str;
        }

        let str = "";
        if (hours > 0) str += `${hours} giờ `;
        if (minutes > 0) str += `${minutes} phút `;
        str += `${seconds} giây`;

        return str.trim();
    }

    function updateRemainingTime() {
        const end = new Date(remaininTimes.getAttribute("data-end-time"));
        const now = new Date();
        const diff = end - now;
        remaininTimes.textContent = formatRemainingTime(diff);
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    const auction = document.querySelector(".auction");
    function redirect() {
        window.location.href = "/auth/signin";
    }

    function extractNumber(str) {
        return Number(str.replace(/\D/g, ""));
    }

    function isAuctionOver() {
        const end = new Date(remaininTimes.getAttribute("data-end-time"));
        const now = new Date();
        return end <= now;
    }

    function formatNumberVN(num) {
        return num.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ".");
    }

    function maskName(name) {
        if (!name || name.length <= 4) return name;
        return '****' + name.slice(-4);
    }

    function formatDateVN(dateStr) {
        const d = new Date(dateStr);
        const hours = d.getHours().toString().padStart(2, '0');
        const mins = d.getMinutes().toString().padStart(2, '0');
        const day = d.getDate().toString().padStart(2, '0');
        const month = (d.getMonth() + 1).toString().padStart(2, '0');
        const year = d.getFullYear();
        return `${hours} giờ ${mins} phút - ${day}/${month}/${year}`;
    }

    const auctionCurPriceElement = document.querySelector(".auction-current-price");
    const auctionBidStepElement = document.querySelector(".auction-bid-step");
    const highestBidderNameElement = document.querySelector(".highest-bidder-name");
    const bidHistoryBody = document.querySelector('[data-tab-panel="history"] tbody');

    let auctionCurPrice = extractNumber(auctionCurPriceElement.innerText);
    const auctionBidStep = extractNumber(auctionBidStepElement.innerText);

    function updateAuctionUI(data) {
        auctionCurPrice = data.auction.current_price;
        auctionCurPriceElement.innerHTML = formatNumberVN(data.auction.current_price) + '<sup class="text-xs">đ</sup>';

        if (data.auction.highest_bidder) {
            highestBidderNameElement.textContent = data.auction.highest_bidder.username;
        }

        if (data.auction.end_at) {
            remaininTimes.setAttribute("data-end-time", data.auction.end_at);
        }
    }

    function addBidsToHistory(newBids, replace = false) {
        if (!bidHistoryBody || !newBids || newBids.length === 0) return;

        const emptyRow = bidHistoryBody.querySelector('td[colspan="3"]');
        if (emptyRow) {
            emptyRow.closest('tr').remove();
        }

        if (replace) {
            while (bidHistoryBody.firstChild) {
                bidHistoryBody.removeChild(bidHistoryBody.firstChild);
            }
        }

        newBids.forEach((bid, index) => {
            const tr = document.createElement('tr');
            tr.className = 'hover:bg-gray-50 transition';
            tr.style.opacity = '0';
            tr.style.transform = 'translateY(-10px)';
            tr.style.transition = 'all 0.3s ease';
            tr.innerHTML = `
                <td class="px-6 py-4 text-sm text-gray-600">${formatDateVN(bid.created_at)}</td>
                <td class="px-6 py-4 text-sm font-medium text-gray-900">${maskName(bid.bidder_name)}</td>
                <td class="px-6 py-4 text-sm font-bold text-primary-500 text-right">${formatNumberVN(bid.amount)} ₫</td>
            `;

            if (replace) {
                bidHistoryBody.appendChild(tr);
            } else {
                bidHistoryBody.insertBefore(tr, bidHistoryBody.firstChild);
            }

            setTimeout(() => {
                tr.style.opacity = '1';
                tr.style.transform = 'translateY(0)';
            }, replace ? index * 50 : 10);
        });
    }

    const formPostBid = document.querySelector("#form-post-bid");
    if (formPostBid) {
        const placeBidButton = formPostBid.querySelector("button");
        const bidPriceInput = formPostBid.querySelector(".bid-input");

        if (typeof CurrencyFormatter !== 'undefined') {
            CurrencyFormatter.applyToInput(bidPriceInput);
        }

        updateBidButtonState();
        setInterval(updateBidButtonState, 1000);

        formPostBid.onsubmit = async function (event) {
            event.preventDefault();

            const bidValue = typeof CurrencyFormatter !== 'undefined'
                ? CurrencyFormatter.unformat(bidPriceInput.value)
                : bidPriceInput.value.replace(/\s/g, '');

            if (!bidValue || bidValue.trim() === '') {
                if (typeof NotificationModal !== 'undefined') {
                    NotificationModal.error('Vui lòng nhập số tiền đấu giá', 'Thiếu thông tin');
                }
                return;
            }

            placeBidButton.disabled = true;
            placeBidButton.innerHTML = `
                <svg class="animate-spin w-5 h-5" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Đang xử lý...
            `;

            try {
                const response = await fetch(formPostBid.action, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        max_price: bidValue,
                        expected_price: auctionCurPrice
                    })
                });

                const data = await response.json();

                if (data.success) {
                    updateAuctionUI(data);
                    addBidsToHistory(data.newBids);
                    bidPriceInput.value = '';

                    if (typeof NotificationModal !== 'undefined') {
                        NotificationModal.success(data.message, 'Thành công');
                    }
                } else {
                    updateAuctionUI(data);

                    if (data.newBids && data.newBids.length > 0) {
                        addBidsToHistory(data.newBids, true);
                    }

                    if (typeof NotificationModal !== 'undefined') {
                        if (data.error === 'PRICE_CHANGED') {
                            NotificationModal.warning(
                                `${data.message} Giá hiện tại: ${formatNumberVN(data.auction.current_price)} VNĐ`,
                                'Giá đã thay đổi'
                            );
                        } else {
                            NotificationModal.error(data.message, 'Không thể đặt giá');
                        }
                    }
                }
            } catch (error) {
                console.error('Error placing bid:', error);
                if (typeof NotificationModal !== 'undefined') {
                    NotificationModal.error('Có lỗi xảy ra. Vui lòng thử lại.', 'Lỗi');
                }
            } finally {
                placeBidButton.disabled = false;
                placeBidButton.innerHTML = `
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                        </path>
                    </svg>
                    Đặt giá
                `;
                updateBidButtonState();
            }
        }

        function updateBidButtonState() {
            if (isAuctionOver()) {
                placeBidButton.disabled = true;
                placeBidButton.textContent = "Đã kết thúc";
                placeBidButton.classList.remove('bg-primary-500', 'hover:bg-primary-600');
                placeBidButton.classList.add('bg-gray-400', 'cursor-not-allowed');
            }
        }
    }


    const formSendMessage = document.querySelector("#form-send-message");
    formSendMessage.onsubmit = async function (event) {
        event.preventDefault();

        const input = formSendMessage.querySelector(".message-input");
        input.oninput = function (event) {
            input.classList.remove("border-red-500");
        }
        if (input.value == "") {
            input.classList.add("border-red-500");
            return;
        }

        const formData = new FormData(formSendMessage);
        const content = formData.get('content');
        const auctionId = formSendMessage.action.split('/')[4];

        try {
            const response = await fetch(`/auctions/${auctionId}/messages`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ content })
            });

            if (response.ok) {
                const data = await response.json();

                const messagesList = document.querySelector('.space-y-4');
                const newMessageHTML = `
                    <div class="bg-white rounded-2xl border border-gray-200 p-5" style="opacity: 0; transform: translateY(-10px); transition: all 0.3s ease;">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="w-9 h-9 bg-gray-100 rounded-full flex items-center justify-center">
                                <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <div>
                                <span class="font-medium text-gray-900">${data.message.sender_name}</span>
                                <span class="text-sm text-gray-500 ml-2">Vừa xong</span>
                            </div>
                        </div>
                        <p class="text-gray-700 mb-4 pl-12">${data.message.content}</p>
                    </div>
                `;

                messagesList.insertAdjacentHTML('afterbegin', newMessageHTML);

                setTimeout(() => {
                    const newMsg = messagesList.firstElementChild;
                    newMsg.style.opacity = '1';
                    newMsg.style.transform = 'translateY(0)';
                }, 10);

                input.value = '';
            }
        } catch (error) {
            console.error('Error sending message:', error);
            NotificationModal.error('Có lỗi xảy ra. Vui lòng thử lại.');
        }
    }

    const formReplyMessage = document.querySelectorAll(".form-reply-message");
    if (formReplyMessage) {
        formReplyMessage.forEach(function (form) {
            form.onsubmit = async function (event) {
                event.preventDefault();

                const input = form.querySelector(".reply-input");
                input.oninput = function () {
                    input.classList.remove("border-red-500");
                }
                if (input.value == "") {
                    input.classList.add("border-red-500");
                    return;
                }

                const formData = new FormData(form);
                const content = formData.get('content');
                const reply_id = formData.get('reply_id');
                const auctionId = form.action.split('/')[4];

                try {
                    const response = await fetch(`/auctions/${auctionId}/messages`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ content, reply_id })
                    });

                    if (response.ok) {
                        const data = await response.json();

                        const messageCard = form.closest('.bg-white');
                        let repliesContainer = messageCard.querySelector('.space-y-3');

                        if (!repliesContainer) {
                            const repliesWrapper = document.createElement('div');
                            repliesWrapper.className = 'mt-4 pl-12 space-y-3';
                            form.parentElement.insertBefore(repliesWrapper, form);
                            repliesContainer = repliesWrapper;
                        }

                        const newReplyHTML = `
                            <div class="bg-primary-50 rounded-xl p-4" style="opacity: 0; transform: translateY(-10px); transition: all 0.3s ease;">
                                <div class="flex items-center gap-2 mb-2">
                                    <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-500 text-white">
                                        Người bán
                                    </span>
                                    <span class="font-medium text-gray-900">${data.message.sender_name}</span>
                                    <span class="text-sm text-gray-500">Vừa xong</span>
                                </div>
                                <p class="text-gray-700">${data.message.content}</p>
                            </div>
                        `;

                        repliesContainer.insertAdjacentHTML('beforeend', newReplyHTML);

                        setTimeout(() => {
                            const newReply = repliesContainer.lastElementChild;
                            newReply.style.opacity = '1';
                            newReply.style.transform = 'translateY(0)';
                        }, 10);

                        input.value = '';
                    }
                } catch (error) {
                    console.error('Error sending reply:', error);
                    NotificationModal.error('Có lỗi xảy ra. Vui lòng thử lại.');
                }
            }
        })
    }

    const btnAddWatchlist = document.querySelector("#btn-add-watchlist");
    if (btnAddWatchlist) {

        btnAddWatchlist.onclick = async function () {
            const auction_id = this.dataset.auctionId;

            try {
                const res = await fetch("/watch-list/add", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ auction_id })
                });

                if (!res.ok) {
                    throw new Error("Request failed");
                }

                const data = await res.json();
                this.innerHTML = `<svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg> Đã thêm`;
                this.classList.add("bg-green-50", "text-green-600", "border-green-300");
            } catch (err) {
                console.error(err);
                NotificationModal.error("Không thể thêm vào danh sách theo dõi");
            }
        }

    }
    document.querySelectorAll('[data-tab-target]').forEach(button => {
        button.addEventListener('click', () => {
            const target = button.dataset.tabTarget;

            document.querySelectorAll('[data-tab-target]').forEach(btn => {
                btn.classList.remove('border-primary-500', 'text-primary-500');
                btn.classList.add('border-transparent', 'text-gray-500');
            });
            button.classList.remove('border-transparent', 'text-gray-500');
            button.classList.add('border-primary-500', 'text-primary-500');

            document.querySelectorAll('[data-tab-panel]').forEach(panel => {
                panel.classList.add('hidden');
            });
            const panel = document.querySelector(`[data-tab-panel="${target}"]`);
            if (panel) {
                panel.classList.remove('hidden');
            }
        });
    });
</script>
{{/section}}

<nav class="py-4">
    <ol class="flex items-center text-sm text-gray-500">
        <li><a href="/" class="hover:text-primary-500">Trang chủ</a></li>
        <li class="mx-2">/</li>
        <li><a href="/auctions" class="hover:text-primary-500">Đấu giá</a></li>
        <li class="mx-2">/</li>
        <li class="text-gray-900 font-medium truncate max-w-xs">{{auction.name}}</li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-12 gap-8 pb-8">
    <div class="lg:col-span-7">
        <div class="bg-white rounded-2xl border border-gray-200 p-4 mb-4">
            <img src="{{imageOrPlaceholder auction.mainImage.url}}" class="w-full h-96 object-contain rounded-xl"
                alt="{{auction.name}}" onerror="this.onerror=null; this.src='/images/placeholder.webp';">
        </div>

        <div class="grid grid-cols-4 gap-3">
            {{#each auction.subImages}}
            <div
                class="bg-white rounded-xl border border-gray-200 p-2 cursor-pointer hover:border-primary-500 transition">
                <img src="{{this.url}}" class="w-full h-20 object-contain rounded-lg" alt=""
                    onerror="this.onerror=null; this.src='/images/placeholder.webp';">
            </div>
            {{/each}}
        </div>
    </div>

    <div class="lg:col-span-5 auction">
        <h1 class="text-2xl font-bold text-gray-900 mb-4">{{auction.name}}</h1>

        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
            <div class="bg-gradient-to-r from-primary-500 to-primary-600 p-4 text-white">
                <div class="flex items-center gap-2 mb-1">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                    </svg>
                    <span class="text-sm font-medium">Thời gian còn lại</span>
                </div>
                <p class="remaining-time text-2xl font-bold" data-end-time="{{auction.end_at}}">00:00:00</p>
                <p class="text-sm text-white/80 mt-1">Kết thúc: {{formatDate auction.end_at}}</p>
            </div>

            <div class="p-5">
                <p class="text-sm text-gray-500 mb-4">
                    <svg class="w-4 h-4 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z">
                        </path>
                    </svg>
                    Đăng ngày: {{formatDate auction.start_at}}
                </p>

                <div class="grid grid-cols-3 gap-3 mb-5">
                    <div class="bg-gray-50 rounded-xl p-3 text-center">
                        <span class="block text-xs text-gray-500 mb-1">Giá hiện tại</span>
                        <span class="block text-lg font-bold text-primary-500 auction-current-price">{{formatNumber
                            auction.current_price}}<sup class="text-xs">đ</sup></span>
                    </div>

                    <div class="bg-gray-50 rounded-xl p-3 text-center">
                        <span class="block text-xs text-gray-500 mb-1">Bước giá</span>
                        <span class="block text-lg font-bold text-gray-900 auction-bid-step">{{formatNumber
                            auction.bid_step}}<sup class="text-xs">đ</sup></span>
                    </div>

                    <div class="bg-gray-50 rounded-xl p-3 text-center">
                        <span class="block text-xs text-gray-500 mb-1">Mua ngay</span>
                        <span class="block text-lg font-bold text-green-600">{{formatNumber auction.buy_now_price}}<sup
                                class="text-xs">đ</sup></span>
                    </div>
                </div>

                <div class="space-y-3 mb-5">
                    <div class="flex items-center justify-between bg-gray-50 rounded-xl px-4 py-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-primary-100 rounded-full flex items-center justify-center">
                                <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                            </div>
                            <div>
                                <span class="block text-xs text-gray-500">Người bán</span>
                                <span class="block font-medium text-gray-900">{{auction.seller.username}}</span>
                            </div>
                        </div>
                        {{#if auction.seller.rating}}
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                                </path>
                            </svg>
                            {{auction.seller.rating}}%
                        </span>
                        {{else}}
                        <span class="text-xs text-gray-400">Chưa có đánh giá</span>
                        {{/if}}
                    </div>

                    <div class="flex items-center justify-between bg-blue-50 rounded-xl px-4 py-3">
                        <div class="flex items-center gap-3">
                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                </svg>
                            </div>
                            <div>
                                <span class="block text-xs text-gray-500">Người đấu giá cao nhất</span>
                                <span
                                    class="block font-medium text-gray-900 highest-bidder-name">{{auction.highestBidder.username}}</span>
                            </div>
                        </div>
                        {{#if auction.highestBidder.rating}}
                        <span
                            class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium bg-green-100 text-green-700">
                            <svg class="w-3 h-3 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path
                                    d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z">
                                </path>
                            </svg>
                            {{auction.highestBidder.rating}}%
                        </span>
                        {{else}}
                        <span class="text-xs text-gray-400">Chưa có đánh giá</span>
                        {{/if}}
                    </div>
                </div>

                {{#if isAuthenticated}}
                <div class="border-t border-gray-200 pt-5">
                    {{#if rating}}
                    {{#if (less rating 80)}}
                    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86
                   c1.54 0 2.5-1.67 1.73-3L13.73 4
                   c-.77-1.33-2.69-1.33-3.46 0L3.34 16
                   c-.77 1.33.19 3 1.73 3z" />
                            </svg>

                            <div>
                                <p class="font-semibold text-sm">
                                    Bạn chưa đủ điều kiện tham gia đấu giá
                                </p>
                                <p class="text-sm mt-1 text-red-600">
                                    Điểm đánh giá hiện tại của bạn là <strong>{{rating}}%</strong>.
                                    Người dùng cần đạt tối thiểu <strong>80%</strong> để được phép ra giá.
                                </p>
                            </div>
                        </div>
                    </div>
                    {{/if}}
                    {{else}}
                    {{#if (include bidderBlocked authUser.id)}}
                    <div class="rounded-xl border border-red-200 bg-red-50 p-4 text-red-700">
                        <div class="flex items-start gap-3">
                            <svg class="w-6 h-6 text-red-500 flex-shrink-0" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M5.07 19h13.86
                                c1.54 0 2.5-1.67 1.73-3L13.73 4
                                c-.77-1.33-2.69-1.33-3.46 0L3.34 16
                                c-.77 1.33.19 3 1.73 3z" />
                            </svg>

                            <div>
                                <p class="font-semibold text-sm">
                                    Bạn không thể tham gia đấu giá
                                </p>
                                <p class="text-sm mt-1 text-red-600">
                                    Tài khoản của bạn đã bị <strong>Chặn bởi người bán</strong> khỏi phiên đấu giá này.
                                </p>
                            </div>
                        </div>
                    </div>
                    {{else}}
                    <form action="/auctions/{{auction.id}}/bids" method="POST" id="form-post-bid">
                        <div class="mb-3">
                            <input type="text" inputmode="numeric" required
                                class="bid-input currency-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                                placeholder="Nhập số tiền đấu giá" name="max_price">
                        </div>
                        <button type="submit"
                            class="w-full py-3 px-4 bg-primary-500 hover:bg-primary-600 text-white font-semibold rounded-xl transition flex items-center justify-center gap-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                                </path>
                            </svg>
                            Đặt giá
                        </button>
                    </form>
                    {{/if}}

                    {{/if}}

                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <button
                            class="py-3 px-4 border border-green-500 text-green-600 hover:bg-green-50 font-semibold rounded-xl transition flex items-center justify-center gap-2"
                            {{#unless isAuthenticated}}onclick="redirect()" {{/unless}}>
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z">
                                </path>
                            </svg>
                            Mua ngay
                        </button>
                        <button id="btn-add-watchlist"
                            class="py-3 px-4 border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium rounded-xl transition flex items-center justify-center gap-2"
                            {{#unless isAuthenticated}}onclick="redirect()" {{/unless}}
                            data-auction-id="{{auction.id}}">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z">
                                </path>
                            </svg>
                            Theo dõi
                        </button>
                    </div>
                </div>
                {{/if}}
            </div>
        </div>
    </div>
</div>

<div class="pb-12">
    <div class="border-b border-gray-200 mb-6">
        <nav class="flex gap-6 -mb-px">
            <button data-tab-target="description"
                class="py-4 px-1 border-b-2 border-primary-500 text-primary-500 font-medium text-sm transition">
                Mô tả sản phẩm
            </button>
            <button data-tab-target="qa"
                class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-medium text-sm transition">
                Hỏi đáp
            </button>
            <button data-tab-target="related"
                class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-medium text-sm transition">
                Sản phẩm liên quan
            </button>
            <button data-tab-target="history"
                class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-medium text-sm transition">
                Lịch sử đấu giá
            </button>
            {{#if isAuthenticated}}
            {{#if (isSellerOfAuction authUser auction)}}
            <button data-tab-target="bidder"
                class="py-4 px-1 border-b-2 border-transparent text-gray-500 hover:text-gray-700 font-medium text-sm transition">
                Danh sách người đấu giá
            </button>
            {{/if}}
            {{/if}}
        </nav>
    </div>

    <div>
        <div data-tab-panel="description" class="bg-white rounded-2xl border border-gray-200 p-6">
            <div class="prose max-w-none">
                {{{auction.description}}}
            </div>
        </div>

        <div data-tab-panel="qa" class="hidden">
            <div class="bg-white rounded-2xl border border-gray-200 p-6 mb-6">
                <h3 class="text-lg font-semibold text-gray-900 mb-4">Đặt câu hỏi cho người bán</h3>
                <form id="form-send-message" action="/auctions/{{auction.id}}/messages" method="POST">
                    <textarea
                        class="message-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition resize-none"
                        rows="3" placeholder="Nhập câu hỏi của bạn..." name="content"></textarea>
                    <button type="submit"
                        class="mt-3 py-2.5 px-5 bg-gray-800 hover:bg-gray-900 text-white font-medium rounded-xl transition flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"></path>
                        </svg>
                        Gửi câu hỏi
                    </button>
                </form>
            </div>

            <div class="space-y-4">
                {{#each messages}}
                <div class="bg-white rounded-2xl border border-gray-200 p-5">
                    <div class="flex items-center gap-3 mb-3">
                        <div class="w-9 h-9 bg-gray-100 rounded-full flex items-center justify-center">
                            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                        </div>
                        <div>
                            <span class="font-medium text-gray-900">{{this.sender_name}}</span>
                            <span class="text-sm text-gray-500 ml-2">{{formatDate this.created_at}}</span>
                        </div>
                    </div>

                    <p class="text-gray-700 mb-4 pl-12">{{this.content}}</p>

                    {{#if ../authUser}}
                    {{#if (isSellerOfAuction ../authUser ../auction)}}
                    <form action="/auctions/{{../auction.id}}/messages" method="POST"
                        class="form-reply-message flex gap-3 pl-12">
                        <input type="text" name="content"
                            class="reply-input flex-1 px-4 py-2.5 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                            placeholder="Trả lời câu hỏi...">
                        <input type="hidden" name="reply_id" value="{{this.id}}">
                        <button type="submit"
                            class="py-2.5 px-5 bg-primary-500 hover:bg-primary-600 text-white font-medium rounded-xl transition">
                            Trả lời
                        </button>
                    </form>
                    {{/if}}
                    {{/if}}

                    {{#if this.replyMessages.length}}
                    <div class="mt-4 pl-12 space-y-3">
                        {{#each this.replyMessages}}
                        <div class="bg-primary-50 rounded-xl p-4">
                            <div class="flex items-center gap-2 mb-2">
                                <span
                                    class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-primary-500 text-white">
                                    Người bán
                                </span>
                                <span class="font-medium text-gray-900">{{this.sender_name}}</span>
                                <span class="text-sm text-gray-500">{{formatDate this.created_at}}</span>
                            </div>
                            <p class="text-gray-700">{{this.content}}</p>
                        </div>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </div>
        </div>

        <div data-tab-panel="related" class="hidden">
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
                {{#each relateAuctons}}
                {{> product-card this}}
                {{/each}}
            </div>
        </div>

        <div data-tab-panel="history" class="hidden">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                <div class="p-5 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900">Lịch sử đấu giá</h3>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Thời gian</th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Người đấu giá</th>
                                <th
                                    class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Số tiền</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200">
                            {{#each bidHistories}}
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 text-sm text-gray-600">{{formatDate this.created_at}}</td>
                                <td class="px-6 py-4 text-sm font-medium text-gray-900">{{maskName this.bidder_name}}
                                </td>
                                <td class="px-6 py-4 text-sm font-bold text-primary-500 text-right">{{formatNumber
                                    this.amount}} ₫</td>
                            </tr>
                            {{/each}}

                            {{#unless bidHistories.length}}
                            <tr>
                                <td colspan="3" class="px-6 py-12 text-center text-gray-500">
                                    <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2">
                                        </path>
                                    </svg>
                                    Chưa có lượt đấu giá nào
                                </td>
                            </tr>
                            {{/unless}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {{#if isAuthenticated}}
        {{#if (isSellerOfAuction authUser auction)}}
        <div data-tab-panel="bidder" class="hidden">
            <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
                <div class="p-5 border-b border-gray-200">
                    <h3 class="text-lg font-semibold text-gray-900">
                        Danh sách người tham gia đấu giá
                    </h3>
                    <p class="text-sm text-gray-500 mt-1">
                        Quản lý các bidder đã từng ra giá cho sản phẩm này
                    </p>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full">
                        <thead class="bg-gray-50">
                            <tr>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Người dùng
                                </th>
                                <th
                                    class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Email
                                </th>
                                <th
                                    class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Điểm đánh giá
                                </th>
                                <th
                                    class="px-6 py-3 text-center text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Số lần đấu giá
                                </th>
                                <th
                                    class="px-6 py-3 text-right text-xs font-semibold text-gray-500 uppercase tracking-wider">
                                    Hành động
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-200">
                            {{#each bidders}}
                            <tr class="hover:bg-gray-50 transition">
                                <td class="px-6 py-4 text-sm font-medium text-gray-900">
                                    {{this.username}}
                                </td>

                                <td class="px-6 py-4 text-sm text-gray-600">
                                    {{this.email}}
                                </td>

                                <td class="px-6 py-4 text-sm text-center">
                                    <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-semibold
                                {{#if (greater this.rating 80)}}
                                    bg-green-100 text-green-700
                                {{else}}
                                    bg-yellow-100 text-yellow-700
                                {{/if}}">
                                        {{this.rating}}%
                                    </span>
                                </td>

                                <td class="px-6 py-4 text-sm text-center text-gray-700">
                                    {{this.total_bids}}
                                </td>

                                <td class="px-6 py-4 text-right">
                                    {{#if (include ../bidderBlocked this.bidder_id)}}
                                    <span class="inline-flex items-center px-3 py-1 rounded-lg text-xs font-semibold
                                           bg-gray-200 text-gray-600">
                                        Đã bị chặn
                                    </span>
                                    {{else}}
                                    <form action="/auctions/{{../auction.id}}/block-bidder" method="POST"
                                        class="inline">
                                        <input type="hidden" name="bidder_id" value="{{this.bidder_id}}">
                                        <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5
                                               rounded-lg text-xs font-semibold
                                               bg-red-100 text-red-600 hover:bg-red-200 transition">
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                    d="M18.364 5.636l-12.728 12.728M5.636 5.636l12.728 12.728" />
                                            </svg>
                                            Chặn
                                        </button>
                                    </form>
                                    {{/if}}
                                </td>
                            </tr>
                            {{/each}}

                            {{#unless bidders.length}}
                            <tr>
                                <td colspan="5" class="px-6 py-12 text-center text-gray-500">
                                    <svg class="w-12 h-12 mx-auto mb-3 text-gray-300" fill="none" stroke="currentColor"
                                        viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M18.364 5.636l-12.728 12.728M5.636 5.636l12.728 12.728" />
                                    </svg>
                                    Chưa có bidder nào tham gia đấu giá
                                </td>
                            </tr>
                            {{/unless}}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        {{/if}}
        {{/if}}
    </div>
</div>