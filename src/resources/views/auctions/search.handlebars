{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "It's over.";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days}d: `;
            if (hours > 0) str += ` ${hours}h: `;
            if (minutes > 0) str += ` ${minutes}m`;
            return str;
        }

        // <= 1 ngày -> hiển thị giây
        let str = "";
        if (hours > 0) str += `${hours}h: `;
        if (minutes > 0) str += `${minutes}m: `;
        str += `${seconds}s`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);
        })
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    const formSelect = document.querySelector(".form-select");
    const formSort = document.querySelector("#form-sort");
    formSelect.onchange = function (event) {
        const type = this.options[this.selectedIndex].dataset.type;
        const url = new URL(window.location.href);
        url.searchParams.set("sort", type);

        window.location.href = url.toString();
    }
</script>
{{/section}}

<div class="row .row-cols-2 g-3 pt-3 pb-3">

    <div class="col col-2 pt-3">
        <div class="card p-2">

            <p class="text mb-0 pb-2">Categories</p>

            {{#each categories}}
            <div class="p-2 border-top border-gray">
                <a href="/auctions/categories/{{this.slug}}" class="text-decoration-none text-dark">{{this.name}}</a>
                <div class="d-flex flex-column">
                    {{#each this.subCategories}}
                    <a href="/auctions/categories/{{this.slug}}" class="text-decoration-none text-secondary ms-2"
                        style="font-size: 14px;">{{this.name}}</a>
                    {{/each}}
                </div>
            </div>
            {{/each}}
        </div>
    </div>

    <div class="col col-10 pt-3">

        <div class="d-flex align-items-center p-3">
            <h4 class="ms-3 me-5">Search result</h4>
            <span class="me-3 ms-3">Sort by</span>
            <select class="form-select w-auto">
                <option selected data-type="end_at-desc">Ending time (descending)</option>
                <option data-type="current_price-asc">Price (ascending)</option>
                <option data-type="current_price-desc">Price (descending)</option>
            </select>
        </div>

        {{#if empty}}
        <p class="text-dark">No results found.</p>
        {{else}}
        <div class="auctions">
            <div class="row row-cols-3 g-3">
                {{#each auctions}}
                <div class="col">
                    <div class="card h-100">
                        <img src="{{this.mainImage.url}}" class="card-img-top card-product-img" alt="Laptop">
                        <div class="card-body card-product-info">
                            <h5 class="card-title">{{this.name}}</h5>
                            <div class="d-flex justify-content-between">
                                <p class="mb-1">Current price:</p>
                                <p class="mb-1">{{this.current_price}}</p>
                            </div>
                            <div class="d-flex justify-content-between">
                                <p class="mb-1">By bidder:</p>
                                <p class="mb-1">{{this.seller.username}}</p>
                            </div>
                            <div class="d-flex justify-content-between">
                                <p class="mb-1">Posted Date:</p>
                                <p class="mb-1">{{formatDate this.start_at}}</p>
                            </div>
                            <div class="d-flex justify-content-between">
                                <p class="mb-2">Remaining time:</p>
                                <p class="mb-2 remaining-time" data-end-time="{{this.end_at}}">{{calcRemainingTime
                                    this.end_at}}</p>
                            </div>
                            <div class="d-flex justify-content-between">
                                <p class="mb-2">Total Bids:</p>
                                <p class="mb-2">18</p>
                            </div>
                            <div class="">
                                <a href="/auctions/{{this.id}}" class="btn btn-primary w-100">Bib now</a>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>
        </div>

        <div class="paging">
            <nav aria-label="Page navigation example">
                <ul class="pagination">
                    <li class="page-item">
                        <a class="page-link" href="/auctions?limit=6&page={{prevPage}}" aria-label="Previous">
                            <span aria-hidden="true">&laquo;</span>
                        </a>
                    </li>
                    {{#each pageNumbers}}
                    {{#if this.isCurrent}}
                    <li class="page-item"><a class="page-link bg-primary text-light"
                            href="/auctions?limit=6&page={{this.value}}">{{this.value}}</a></li>
                    {{else}}
                    <li class="page-item"><a class="page-link"
                            href="/auctions?limit=6&page={{this.value}}">{{this.value}}</a></li>
                    {{/if}}
                    {{/each}}
                    <li class="page-item">
                        <a class="page-link" href="/auctions?limit=6&page={{nextPage}}" aria-label="Next">
                            <span aria-hidden="true">&raquo;</span>
                        </a>
                    </li>
                </ul>
            </nav>
        </div>
        {{/if}}

    </div>


</div>