{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days} ngày `;
            if (hours > 0) str += ` ${hours} giờ `;
            if (minutes > 0) str += ` ${minutes} phút`;
            return str;
        }

        let str = "";
        if (hours > 0) str += `${hours} giờ `;
        if (minutes > 0) str += `${minutes} phút `;
        str += `${seconds} giây`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);
        })
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    const sortSelect = document.querySelector("#sort-select");
    sortSelect.onchange = function (event) {
        const type = this.options[this.selectedIndex].dataset.type;
        const url = new URL(window.location.href);
        url.searchParams.set("sort", type);
        window.location.href = url.toString();
    }
</script>
{{/section}}

<div class="grid grid-cols-1 lg:grid-cols-5 gap-6 py-6">
    <!-- Sidebar Categories -->
    <aside class="lg:col-span-1">
        <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden sticky top-24">
            <div class="bg-gray-50 px-4 py-3 border-b border-gray-200">
                <h3 class="font-semibold text-gray-900">Danh mục</h3>
            </div>
            <div class="p-3">
                {{#each categories}}
                <div class="mb-3">
                    <a href="/auctions/categories/{{this.slug}}"
                        class="font-medium text-gray-900 hover:text-primary-500 transition">{{this.name}}</a>
                    <div class="mt-1 ml-3 space-y-1">
                        {{#each this.subCategories}}
                        <a href="/auctions/categories/{{this.slug}}"
                            class="block text-sm text-gray-500 hover:text-primary-500 transition">{{this.name}}</a>
                        {{/each}}
                    </div>
                </div>
                {{/each}}
            </div>
        </div>
    </aside>

    <!-- Main Content -->
    <main class="lg:col-span-4">
        <!-- Header -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
            <h1 class="text-2xl font-bold text-gray-900">Kết quả tìm kiếm</h1>
            <div class="flex items-center gap-3">
                <span class="text-sm text-gray-500">Sắp xếp theo:</span>
                <select id="sort-select"
                    class="px-4 py-2 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition bg-white text-sm">
                    <option selected data-type="end_at-desc">Thời gian kết thúc (giảm dần)</option>
                    <option data-type="current_price-asc">Giá (tăng dần)</option>
                    <option data-type="current_price-desc">Giá (giảm dần)</option>
                </select>
            </div>
        </div>

        {{#if empty}}
        <div class="text-center py-16">
            <svg class="w-20 h-20 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
            <p class="text-xl font-medium text-gray-700 mb-2">Không tìm thấy kết quả</p>
            <p class="text-gray-500">Hãy thử tìm kiếm với từ khóa khác</p>
        </div>
        {{else}}
        <!-- Products Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">
            {{#each auctions}}
            <a href="/auctions/{{this.id}}"
                class="group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-primary-200 transition-all">
                <div class="aspect-square overflow-hidden bg-gray-50">
                    <img src="{{imageOrPlaceholder this.mainImage.url}}"
                        class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                        alt="{{this.name}}" onerror="this.onerror=null; this.src='/images/placeholder.webp';">
                </div>
                <div class="p-4">
                    <h3 class="font-medium text-gray-900 line-clamp-2 mb-3 group-hover:text-primary-500 transition">
                        {{this.name}}</h3>
                    <div class="space-y-1.5 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-500">Giá hiện tại:</span>
                            <span class="font-bold text-primary-500">{{formatNumber
                                this.current_price}}<sup>đ</sup></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-500">Người đấu cao nhất:</span>
                            <span class="text-gray-700">{{this.highestBidder.username}}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-500">Ngày đăng:</span>
                            <span class="text-gray-700">{{formatDate this.start_at}}</span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-500">Còn lại:</span>
                            <span class="font-medium text-orange-500 remaining-time"
                                data-end-time="{{this.end_at}}">{{calcRemainingTime this.end_at}}</span>
                        </div>
                    </div>
                    <button
                        class="w-full mt-4 py-2.5 bg-primary-500 hover:bg-primary-600 text-white font-medium rounded-xl transition">
                        Đấu giá ngay
                    </button>
                </div>
            </a>
            {{/each}}
        </div>

        <!-- Pagination -->
        <nav class="flex justify-center">
            <div class="inline-flex items-center gap-1">
                <a href="/auctions?limit=6&page={{prevPage}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
                        </path>
                    </svg>
                </a>
                {{#each pageNumbers}}
                {{#if this.isCurrent}}
                <a href="/auctions?limit=6&page={{this.value}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg bg-primary-500 text-white font-medium">{{this.value}}</a>
                {{else}}
                <a href="/auctions?limit=6&page={{this.value}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition text-gray-700">{{this.value}}</a>
                {{/if}}
                {{/each}}
                <a href="/auctions?limit=6&page={{nextPage}}"
                    class="w-10 h-10 flex items-center justify-center rounded-lg border border-gray-300 hover:bg-gray-50 transition">
                    <svg class="w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </a>
            </div>
        </nav>
        {{/if}}
    </main>
</div>