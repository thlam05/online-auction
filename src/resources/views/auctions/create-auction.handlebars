{{#section "css"}}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
<style>
    .ql-toolbar {
        border-radius: 12px 12px 0 0;
        border-color: #e5e7eb !important;
    }

    .ql-container {
        border-radius: 0 0 12px 12px;
        border-color: #e5e7eb !important;
        min-height: 150px;
    }

    .ql-editor {
        min-height: 150px;
    }
</style>
{{/section}}

{{#section "js"}}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const quill = new Quill('#description-editor', {
            theme: 'snow',
            placeholder: 'Nhập mô tả chi tiết về sản phẩm...',
            modules: {
                toolbar: [
                    ['bold', 'italic', 'underline', 'strike'],
                    ['blockquote', 'code-block'],
                    [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                    [{ 'header': [1, 2, 3, 4, 5, 6, false] }],
                    ['link', 'image'],
                    ['clean']
                ]
            }
        });

        // Format number with thousands separator
        function formatNumber(value) {
            const num = value.replace(/\D/g, '');
            return num.replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        }

        function unformatNumber(value) {
            return value.replace(/,/g, '');
        }

        // Add formatting to price inputs
        const priceInputs = ['#starting-step-product', '#price-step-product', '#cost-buy-now-product'];
        priceInputs.forEach(selector => {
            const input = document.querySelector(selector);
            if (input) {
                // Change type to text for formatting
                input.type = 'text';

                input.addEventListener('input', function (e) {
                    const cursorPosition = e.target.selectionStart;
                    const oldLength = e.target.value.length;
                    const formatted = formatNumber(e.target.value);
                    e.target.value = formatted;

                    // Adjust cursor position after formatting
                    const newLength = formatted.length;
                    const diff = newLength - oldLength;
                    e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
                });
            }
        });

        const form = document.querySelector("#form-create-auction");

        function removeClassInvalid(event) {
            event.target.classList.remove("border-red-500");
        }

        form.onsubmit = function (event) {
            event.preventDefault();

            const htmlDes = quill.root.innerHTML;
            const description = form.querySelector("#description-hidden");
            description.value = htmlDes;

            let isValid = true;

            const inputName = form.querySelector("#name-product");
            if (inputName.value.trim() == "") {
                isValid = false;
                inputName.classList.add("border-red-500");
            }
            inputName.oninput = removeClassInvalid;

            const mainImage = form.querySelector("#main-image-product");
            if (!mainImage.value) {
                isValid = false;
                mainImage.classList.add("border-red-500");
            }
            mainImage.onclick = removeClassInvalid;

            const subImage = form.querySelector("#sub-image-product");
            if (!subImage.value || subImage.files.length < 3 || subImage.files.length > 10) {
                isValid = false;
                subImage.classList.add("border-red-500");
            }
            subImage.onclick = removeClassInvalid;

            const startingPrice = form.querySelector("#starting-step-product");
            const startingPriceValue = unformatNumber(startingPrice.value);
            if (!startingPriceValue || Number(startingPriceValue) < 0) {
                isValid = false;
                startingPrice.classList.add("border-red-500");
            } else {
                // Set unformatted value for submission
                startingPrice.value = startingPriceValue;
            }
            startingPrice.oninput = removeClassInvalid;

            const priceStep = form.querySelector("#price-step-product");
            const priceStepValue = unformatNumber(priceStep.value);
            if (!priceStepValue || Number(priceStepValue) < 0) {
                isValid = false;
                priceStep.classList.add("border-red-500");
            } else {
                // Set unformatted value for submission
                priceStep.value = priceStepValue;
            }
            priceStep.oninput = removeClassInvalid;

            const duration = form.querySelector("#duration");
            if (!duration.value || Number(duration.value) < 0) {
                isValid = false;
                duration.classList.add("border-red-500");
            }
            duration.oninput = removeClassInvalid;

            // Handle buy now price (optional field)
            const costBuyNow = form.querySelector("#cost-buy-now-product");
            if (costBuyNow.value) {
                costBuyNow.value = unformatNumber(costBuyNow.value);
            }

            if (isValid == false) {
                return;
            }

            form.submit();
        }
    });
</script>
{{/section}}

<nav class="py-4">
    <ol class="flex items-center text-sm text-gray-500">
        <li><a href="/" class="hover:text-primary-500">Trang chủ</a></li>
        <li class="mx-2">/</li>
        <li><a href="/user/auctions" class="hover:text-primary-500">Đấu giá của tôi</a></li>
        <li class="mx-2">/</li>
        <li class="text-gray-900 font-medium">Tạo đấu giá mới</li>
    </ol>
</nav>

<div class="max-w-4xl mx-auto pb-12">
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
        <div class="bg-gradient-to-r from-primary-500 to-primary-600 px-6 py-5">
            <h1 class="text-xl font-semibold text-white flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                </svg>
                Tạo đấu giá mới
            </h1>
            <p class="text-white/80 text-sm mt-1">Điền thông tin sản phẩm để bắt đầu đấu giá</p>
        </div>

        <form id="form-create-auction" class="p-6" action="/auctions" method="post" enctype="multipart/form-data">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div class="md:col-span-2">
                    <label for="name-product" class="block text-sm font-medium text-gray-700 mb-2">Tên sản phẩm</label>
                    <input type="text"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="name-product" name="name" placeholder="Nhập tên sản phẩm...">
                </div>

                <div>
                    <label for="main-image-product" class="block text-sm font-medium text-gray-700 mb-2">Ảnh
                        chính</label>
                    <input type="file"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100"
                        id="main-image-product" name="mainImage">
                </div>

                <div>
                    <label for="sub-image-product" class="block text-sm font-medium text-gray-700 mb-2">Ảnh phụ (3-10
                        ảnh)</label>
                    <input type="file"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-medium file:bg-primary-50 file:text-primary-600 hover:file:bg-primary-100"
                        id="sub-image-product" name="subImage" multiple>
                </div>

                <div>
                    <label for="starting-step-product" class="block text-sm font-medium text-gray-700 mb-2">Giá khởi
                        điểm (VNĐ)</label>
                    <input type="number"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="starting-step-product" name="startingPrice" placeholder="0">
                </div>

                <div>
                    <label for="price-step-product" class="block text-sm font-medium text-gray-700 mb-2">Bước giá
                        (VNĐ)</label>
                    <input type="number"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="price-step-product" name="priceStep" placeholder="0">
                </div>

                <div>
                    <label for="cost-buy-now-product" class="block text-sm font-medium text-gray-700 mb-2">Giá mua ngay
                        (VNĐ)</label>
                    <input type="number"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="cost-buy-now-product" name="costBuyNow" placeholder="Để trống nếu không cho phép">
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-2">Danh mục</label>
                    <select
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition bg-white"
                        name="categoryId">
                        {{#each categories}}
                        {{#each this.subCategories}}
                        <option value="{{this.id}}">{{this.name}}</option>
                        {{/each}}
                        {{/each}}
                    </select>
                </div>

                <div>
                    <label for="duration" class="block text-sm font-medium text-gray-700 mb-2">Thời gian (giờ)</label>
                    <input type="number"
                        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                        id="duration" name="duration" placeholder="24">
                </div>

                <div class="md:col-span-2 mb-16">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả sản phẩm</label>
                    <div id="description-editor">

                    </div>
                    <input type="text" hidden name="description" id="description-hidden">
                </div>

                <div class="md:col-span-2 p-4 bg-gray-50 rounded-xl border border-gray-200">
                    <div class="flex items-start gap-3">
                        <input type="checkbox" id="autoRenew" name="auto_renew" value="true"
                            class="shrink-0 w-7 h-7 border-2 border-gray-300 rounded text-primary-600 focus:ring-primary-500 mt-1">
                        <label for="autoRenew" class="cursor-pointer">
                            <span class="block text-sm font-semibold text-gray-800">
                                Tự động gia hạn khi có người đấu giá trong 5 phút cuối
                            </span>
                            <span class="block text-xs text-gray-500 mt-1">
                                Khi được bật, sản phẩm sẽ tự động gia hạn thêm 10 phút nếu có lượt đấu giá mới trong 5
                                phút cuối
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="mt-8 flex justify-end">
                <button type="submit"
                    class="inline-flex items-center gap-2 py-3 px-8 bg-primary-500 hover:bg-primary-600 text-white font-semibold rounded-xl transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M12 6v6m0 0v6m0-6h6m-6 0H6"></path>
                    </svg>
                    Tạo đấu giá
                </button>
            </div>
        </form>
    </div>
</div>