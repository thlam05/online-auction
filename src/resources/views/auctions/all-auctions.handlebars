{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            return `${days}d ${hours}h ${minutes}m`;
        }

        let str = "";
        if (hours > 0) str += `${hours}h `;
        if (minutes > 0) str += `${minutes}m `;
        str += `${seconds}s`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);

            if (diff > 0 && diff < 3600000) {
                element.classList.add('text-primary-500', 'animate-pulse', 'font-bold');
            }
        })
    }

    updateRemainingTime();
    setInterval(updateRemainingTime, 1000);
</script>
{{/section}}

<div class="flex gap-6">
    <!-- Sidebar Categories -->
    <aside class="hidden lg:block w-64 flex-shrink-0">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-4 sticky top-20">
            <h3 class="font-semibold text-gray-900 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-primary-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Danh mục
            </h3>

            <nav class="space-y-1">
                {{#each categories}}
                <div class="border-t border-gray-100 pt-3 first:border-0 first:pt-0">
                    <a href="/auctions/categories/{{this.slug}}"
                        class="flex items-center justify-between px-3 py-2 text-gray-700 hover:bg-primary-50 hover:text-primary-500 rounded-lg transition-colors font-medium">
                        {{this.name}}
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                    </a>
                    {{#if this.subCategories}}
                    <div class="ml-3 mt-1 space-y-1">
                        {{#each this.subCategories}}
                        <a href="/auctions/categories/{{this.slug}}"
                            class="block px-3 py-1.5 text-sm text-gray-500 hover:text-primary-500 hover:bg-primary-50 rounded-lg transition-colors">
                            {{this.name}}
                        </a>
                        {{/each}}
                    </div>
                    {{/if}}
                </div>
                {{/each}}
            </nav>
        </div>
    </aside>

    <!-- Main Content -->
    <div class="flex-1 min-w-0">
        <!-- Header -->
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
            <div>
                <h1 class="text-2xl font-bold text-gray-900">Tất cả đấu giá</h1>
                <p class="text-gray-500 mt-1">Khám phá hàng ngàn sản phẩm đang được đấu giá</p>
            </div>

            <!-- Mobile Category Button -->
            <button type="button"
                class="lg:hidden inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-gray-700 hover:bg-gray-50"
                data-hs-overlay="#category-sidebar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h7" />
                </svg>
                Danh mục
            </button>
        </div>

        {{#if empty}}
        <!-- Empty State -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-12 text-center">
            <div class="w-16 h-16 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4" />
                </svg>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 mb-2">Không có sản phẩm nào</h3>
            <p class="text-gray-500">Hiện tại chưa có sản phẩm đấu giá nào.</p>
        </div>
        {{else}}
        <!-- Products Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
            {{#each auctions}}
            <a href="/auctions/{{this.id}}" class="product-card group">
                <div class="relative overflow-hidden">
                    <img src="{{imageOrPlaceholder this.mainImage.url}}" alt="{{this.name}}" class="product-card-img"
                        onerror="this.onerror=null; this.src='/images/placeholder.webp';">
                    {{#if this.isNew}}
                    <div class="absolute top-2 left-2">
                        <span class="badge badge-primary">Mới</span>
                    </div>
                    {{/if}}
                </div>
                <div class="product-card-body">
                    <h3 class="product-card-title">{{this.name}}</h3>

                    <div class="space-y-2 text-sm mb-4">
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500">Giá hiện tại:</span>
                            <span class="product-card-price">{{formatNumber this.current_price}}<sup
                                    class="text-xs">đ</sup></span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500">Người đặt:</span>
                            <span class="text-gray-700 font-medium">{{this.highestBidder.username}}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500">Ngày đăng:</span>
                            <span class="text-gray-700">{{formatDate this.start_at}}</span>
                        </div>
                        <div class="flex justify-between items-center">
                            <span class="text-gray-500">Còn lại:</span>
                            <span class="remaining-time font-semibold text-gray-900"
                                data-end-time="{{this.end_at}}">--:--:--</span>
                        </div>
                    </div>

                    <span
                        class="w-full inline-flex justify-center items-center gap-2 py-2.5 px-4 bg-primary-500 text-white font-medium rounded-lg group-hover:bg-primary-600 transition-colors">
                        Đấu giá ngay
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                    </span>
                </div>
            </a>
            {{/each}}
        </div>

        <!-- Pagination -->
        <nav class="flex items-center justify-center gap-1">
            <a href="/auctions?limit=6&page={{prevPage}}"
                class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
            </a>

            {{#each pageNumbers}}
            {{#if this.isCurrent}}
            <span class="w-10 h-10 flex items-center justify-center bg-primary-500 text-white font-medium rounded-lg">
                {{this.value}}
            </span>
            {{else}}
            <a href="/auctions?limit=6&page={{this.value}}"
                class="w-10 h-10 flex items-center justify-center text-gray-700 hover:bg-gray-100 rounded-lg transition-colors font-medium">
                {{this.value}}
            </a>
            {{/if}}
            {{/each}}

            <a href="/auctions?limit=6&page={{nextPage}}"
                class="p-2 text-gray-500 hover:text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
            </a>
        </nav>
        {{/if}}
    </div>
</div>

<!-- Mobile Category Sidebar -->
<div id="category-sidebar"
    class="hs-overlay hidden fixed inset-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none lg:hidden">
    <div
        class="hs-overlay-open:translate-x-0 -translate-x-full transition-all duration-300 transform fixed top-0 start-0 bottom-0 z-[80] w-72 bg-white border-e pointer-events-auto">
        <div class="flex justify-between items-center py-3 px-4 border-b">
            <h3 class="font-bold text-gray-800">Danh mục</h3>
            <button type="button"
                class="flex items-center justify-center w-8 h-8 text-gray-400 hover:bg-gray-100 rounded-lg"
                data-hs-overlay="#category-sidebar">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <nav class="p-4 space-y-1">
            {{#each categories}}
            <div class="border-t border-gray-100 pt-3 first:border-0 first:pt-0">
                <a href="/auctions/categories/{{this.slug}}"
                    class="block px-3 py-2 text-gray-700 hover:bg-primary-50 hover:text-primary-500 rounded-lg font-medium">
                    {{this.name}}
                </a>
                {{#each this.subCategories}}
                <a href="/auctions/categories/{{this.slug}}"
                    class="block px-3 py-1.5 ml-3 text-sm text-gray-500 hover:text-primary-500">
                    {{this.name}}
                </a>
                {{/each}}
            </div>
            {{/each}}
        </nav>
    </div>
</div>