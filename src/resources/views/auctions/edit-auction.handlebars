{{#section "css"}}
<link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
<style>
    .ql-toolbar {
        border-radius: 12px 12px 0 0;
        border-color: #e5e7eb !important;
    }

    .ql-container {
        border-radius: 0 0 12px 12px;
        border-color: #e5e7eb !important;
        min-height: 150px;
    }

    .ql-editor {
        min-height: 150px;
    }
</style>
{{/section}}

{{#section "js"}}
<script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
<script>
    const quill = new Quill('#description-editor', {
        theme: 'snow',
        readOnly: true
    });

    const newQuill = new Quill('#new-description-editor', {
        theme: 'snow',
    });

    const form = document.querySelector("#form-edit-auction");

    form.onsubmit = function (event) {
        event.preventDefault();

        const htmlDes = newQuill.root.innerHTML;
        const description = form.querySelector("#description-hidden");
        description.value = htmlDes;

        if (description.value == "" || description.value == "<p>Thêm mô tả bổ sung tại đây...</p>") {
            return;
        }

        form.submit();
    }
</script>
{{/section}}

<!-- Breadcrumb -->
<nav class="py-4">
    <ol class="flex items-center text-sm text-gray-500">
        <li><a href="/" class="hover:text-primary-500">Trang chủ</a></li>
        <li class="mx-2">/</li>
        <li><a href="/user/auctions" class="hover:text-primary-500">Đấu giá của tôi</a></li>
        <li class="mx-2">/</li>
        <li class="text-gray-900 font-medium">Chỉnh sửa mô tả</li>
    </ol>
</nav>

<div class="max-w-4xl mx-auto pb-12">
    <div class="bg-white rounded-2xl border border-gray-200 overflow-hidden">
        <!-- Header -->
        <div class="bg-gradient-to-r from-gray-700 to-gray-800 px-6 py-5">
            <h1 class="text-xl font-semibold text-white flex items-center gap-3">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                    </path>
                </svg>
                Chỉnh sửa mô tả
            </h1>
            <p class="text-white/80 text-sm mt-1">Bổ sung thêm mô tả cho sản phẩm đấu giá</p>
        </div>

        <!-- Form -->
        <form id="form-edit-auction" class="p-6" action="/auctions/edit" method="post">
            <input type="hidden" name="auction_id" value="{{auction.id}}">

            <!-- Current Description -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Mô tả hiện tại</label>
                <div class="bg-gray-50 rounded-xl p-4 border border-gray-200">
                    <div id="description-editor">
                        {{{auction.description}}}
                    </div>
                </div>
            </div>

            <!-- New Description -->
            <div class="mb-6">
                <label class="block text-sm font-medium text-gray-700 mb-2">Thêm mô tả bổ sung</label>
                <div id="new-description-editor">
                    <p>Thêm mô tả bổ sung tại đây...</p>
                </div>
                <input type="text" hidden name="description" id="description-hidden">
                <p class="text-xs text-gray-500 mt-2">Mô tả bổ sung sẽ được thêm vào sau mô tả hiện tại</p>
            </div>

            <!-- Submit Button -->
            <div class="flex justify-end gap-3">
                <a href="/user/auctions"
                    class="py-3 px-6 border border-gray-300 text-gray-700 hover:bg-gray-50 font-medium rounded-xl transition">
                    Hủy
                </a>
                <button type="submit"
                    class="inline-flex items-center gap-2 py-3 px-6 bg-primary-500 hover:bg-primary-600 text-white font-semibold rounded-xl transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                    Cập nhật
                </button>
            </div>
        </form>
    </div>
</div>