{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days}d ${hours}h ${minutes}m`;
            return str;
        }

        // <= 1 ngày -> hiển thị giây
        let str = "";
        if (hours > 0) str += `${hours}h `;
        if (minutes > 0) str += `${minutes}m `;
        str += `${seconds}s`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);

            // Add urgent class when less than 1 hour
            if (diff > 0 && diff < 3600000) {
                element.classList.add('text-primary-500', 'animate-pulse', 'font-bold');
            }
        })
    }

    updateRemainingTime();
    setInterval(updateRemainingTime, 1000);
</script>
{{/section}}

<!-- Hero Banner - Clean design -->
<section class="relative bg-white border border-border rounded-xl overflow-hidden mb-8">
    <div class="grid md:grid-cols-2 gap-6">
        <div class="px-8 py-10 md:py-14">
            <span class="badge badge-primary mb-4">Sàn đấu giá trực tuyến #1</span>
            <h1 class="text-2xl md:text-3xl font-bold text-foreground mb-3">
                Chào mừng đến với <img src="/images/logo-black.svg" alt="bidhub"
                    style="height: 0.9em; display: inline; vertical-align: baseline;">
            </h1>
            <p class="text-muted-foreground mb-6">
                Sàn đấu giá trực tuyến uy tín - Hàng ngàn sản phẩm chất lượng đang chờ bạn khám phá!
            </p>
            <div class="flex flex-wrap gap-3">
                <a href="/auctions" class="btn-primary">
                    Xem các mặt hàng đấu giá
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                </a>
                {{#unless isAuthenticated}}
                <a href="/auth/signup" class="btn-outline">
                    Tạo tài khoản
                </a>
                {{/unless}}
            </div>
        </div>
        <div class="md:block bg-gradient-to-br from-primary-50 to-accent-50 overflow-hidden h-full min-h-[200px]">
            <img src="/images/banner.webp" alt="Welcome to bidhub" class="w-full h-full object-cover">
        </div>
    </div>
</section>

