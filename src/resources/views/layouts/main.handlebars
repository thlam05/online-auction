<!DOCTYPE html>
<html lang="vi" class="scroll-smooth">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Online Auction - Sàn Đấu Giá Trực Tuyến</title>

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">

    <!-- Tailwind CSS Output -->
    <link rel="stylesheet" href="/css/output.css">

    <!-- Preline UI -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/preline@3/dist/preline.min.css">

    <!-- Inter Font -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">

    <!-- Heroicons (Alternative to Bootstrap Icons) -->
    <script src="https://unpkg.com/@heroicons/vue@2.0.18/dist/cjs/index.cjs" defer></script>

    {{{_sections.css}}}
</head>

<body class="bg-gray-50 font-sans antialiased">
    {{> header}}

    <main id="content" class="min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
            {{{body}}}
        </div>
    </main>

    {{> footer}}

    <!-- Preline JS -->
    <script src="https://cdn.jsdelivr.net/npm/preline@3/dist/preline.min.js"></script>
    {{{_sections.js}}}
</body>

</html>