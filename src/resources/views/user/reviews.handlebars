<div class="">
    <p class="fs-4 border-bottom border-gray">Rating and reviews</p>

    <div class="row mx-4 py-2 border-bottom border-gray">
        <div class="col d-flex flex-column text-center border-end border-gray">
            <span class="text-secondary fs-5">Rating</span>
            <span class="fw-semibold fs-4">{{rating}}%</span>
        </div>

        <div class="col d-flex flex-column text-center">
            <span class="text-secondary fs-5">Number of reviews</span>
            <span class="fw-semibold fs-4">{{listReviews.length}}</span>
        </div>
    </div>

    <div class="pt-2" style="max-height: 400px; overflow-y: auto;">

        {{#each listReviews}}
        <div class="d-flex align-items-center gap-3 p-3 rounded border mt-2">
            <div class="d-flex flex-column">
                <span class="text-secondary small">Name</span>
                <span class="fw-semibold">{{this.rater_name}}</span>
            </div>
            <div class="vr mx-2"></div>
            <div class="d-flex flex-column">
                <span class="text-secondary small">Rating</span>
                {{#if (equal this.rating '1')}}
                <span class="fw-semibold text-success">+1</span>
                {{else}}
                <span class="fw-semibold text-danger">-1</span>
                {{/if}}
            </div>
            <div class="vr mx-2"></div>
            <div class="d-flex flex-column">
                <span class="text-secondary small">Comments</span>
                {{#if this.content}}
                <span class="fw-semibold text-muted">{{this.content}}</span>
                {{else}}
                <span class="fw-semibold text-muted">No comment</span>
                {{/if}}
            </div>
        </div>
        {{/each}}
    </div>
</div>