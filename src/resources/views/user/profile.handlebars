            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                </path>
            </svg>
            Chỉnh sửa
        </button>
    </div>

    <div id="modalOverlay" class="hidden fixed inset-0 bg-black/50 z-50"></div>
    <div id="modalVerify"
        class="hidden fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl shadow-xl z-50 w-full max-w-md p-6">
        <div class="flex items-center justify-between mb-4">
            <h3 class="text-lg font-semibold text-gray-900">Xác nhận mật khẩu</h3>
            <button class="close-modal text-gray-400 hover:text-gray-600">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12">
                    </path>
                </svg>
            </button>
        </div>
        <p class="text-gray-600 mb-4">Vui lòng nhập mật khẩu để chỉnh sửa hồ sơ:</p>
        <form id="verifyForm">
            <input type="password" id="verifyPassword"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition"
                placeholder="Nhập mật khẩu">
            <div id="passwordError" class="hidden text-red-500 text-sm mt-2">
                Mật khẩu không đúng. Vui lòng thử lại.
            </div>
            <div class="flex gap-3 mt-4">
                <button type="button"
                    class="close-modal flex-1 py-2.5 px-4 border border-gray-300 text-gray-700 rounded-xl hover:bg-gray-50 transition font-medium">Hủy</button>
                <button type="submit"
                    class="flex-1 py-2.5 px-4 bg-primary-500 text-white rounded-xl hover:bg-primary-600 transition font-medium">Xác
                    nhận</button>
            </div>
        </form>
    </div>

    <form class="grid grid-cols-1 md:grid-cols-2 gap-5 mb-8" id="formEditProfile">
        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Họ và tên</label>
            <input type="text"
                class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition disabled:bg-gray-100 disabled:cursor-not-allowed"
                name="username" value="{{authUser.username}}" autocomplete="name" disabled>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Email</label>
            <input type="text"
                class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition disabled:bg-gray-100 disabled:cursor-not-allowed"
                name="email" value="{{authUser.email}}" autocomplete="email" disabled>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Địa chỉ</label>
            <input type="text"
                class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition disabled:bg-gray-100 disabled:cursor-not-allowed"
                name="address" value="{{authUser.address}}" autocomplete="street-address" disabled>
        </div>

        <div>
            <label class="block text-sm font-medium text-gray-700 mb-2">Ngày sinh</label>
            <input type="date"
                class="form-input w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition disabled:bg-gray-100 disabled:cursor-not-allowed"
                name="birthday" value="{{formatDate authUser.birthday}}" autocomplete="bday" disabled>
        </div>

        <div class="md:col-span-2 flex items-center justify-between">
            <button type="submit"
                class="py-2.5 px-6 bg-gray-800 text-white rounded-xl hover:bg-gray-900 transition font-medium disabled:opacity-50 disabled:cursor-not-allowed"
                disabled>Cập nhật</button>
            <p class="text-sm message"></p>
        </div>
    </form>

