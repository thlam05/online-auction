{{#section "js"}}
<script>
    const modalVerify = document.querySelector("#modalVerify");
    const modalOverlay = document.querySelector("#modalOverlay");
    const openModalBtn = document.querySelector("#openVerifyModal");
    const closeModalBtns = document.querySelectorAll(".close-modal");

    function openModal() {
        modalVerify.classList.remove("hidden");
        modalOverlay.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        modalVerify.classList.add("hidden");
        modalOverlay.classList.add("hidden");
        document.body.style.overflow = "";
    }

    openModalBtn.addEventListener("click", openModal);
    modalOverlay.addEventListener("click", closeModal);
    closeModalBtns.forEach(btn => btn.addEventListener("click", closeModal));

    const formVerify = document.querySelector("#verifyForm");
    formVerify.onsubmit = async (e) => {
        e.preventDefault();
        const password = document.querySelector('#verifyPassword').value;

        const response = await fetch('/auth/verify-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ password }),
        });

        const result = await response.json();

        if (result.valid) {
            document.getElementById("passwordError").classList.add("hidden");

            const inputField = document.querySelectorAll("[disabled]");
            inputField.forEach((input) => {
                input.removeAttribute('disabled');
            });

            closeModal();
        } else {
            document.querySelector("#passwordError").classList.remove("hidden");
        }
    };

    const validateEmail = (email) => {
        return String(email)
            .toLowerCase()
            .match(
                /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|.(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
            );
    };

    const formEditProfile = document.querySelector("#formEditProfile");
    formEditProfile.onsubmit = async (e) => {
        e.preventDefault();

        const formControl = formEditProfile.querySelectorAll(".form-input");
        let formIsValid = true;
        formControl.forEach((input) => {
            if ((input.getAttribute("name") == "username" || input.getAttribute("name") == "address") && input.value.trim() === "") {
                input.classList.add("border-red-500");
                formIsValid = false;
                return;
            }
            else if (input.getAttribute("name") == "email" && !validateEmail(input.value)) {
                input.classList.add("border-red-500");
                formIsValid = false
                return;
            }
            else {
                input.classList.remove("border-red-500");
            }
        });

        if (!formIsValid) return;
        else {
            const formData = new FormData(e.target);
            const body = Object.fromEntries(formData);

            const response = await fetch('/user/profile', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(body),
            });

            const result = await response.json();
            console.log(result);
            if (result.status === 0) {
                const message = formEditProfile.querySelector(".message");
                message.classList.remove("text-red-500");
                message.classList.add("text-green-500");
                message.textContent = result.message;
            }
            else if (result.status == 3) {
                if (result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                }
            }
            else {
                const message = formEditProfile.querySelector(".message");
                message.classList.remove("text-green-500");
                message.classList.add("text-red-500");
                message.textContent = result.message;
            }
        }
    }


    const showPasswordBtn = document.querySelectorAll(".show-password-btn");
    showPasswordBtn.forEach((btn) => {
        btn.addEventListener("click", function (e) {
            e.preventDefault();
            const input = btn.closest(".password-wrapper").querySelector("input");
            const showIcon = btn.querySelector(".icon-show");
            const hideIcon = btn.querySelector(".icon-hide");

            if (input.type === "password") {
                input.type = "text";
                showIcon.classList.add("hidden");
                hideIcon.classList.remove("hidden");
            } else {
                input.type = "password";
                showIcon.classList.remove("hidden");
                hideIcon.classList.add("hidden");
            }
        });
    });

    const formEditPassword = document.querySelector("#formEditPassword");
    formEditPassword.onsubmit = async (e) => {
        e.preventDefault();

        const currentPassword = formEditPassword.querySelector('.form-input[name="currentPassword"]');
        const newPassword = formEditPassword.querySelector('.form-input[name="password"]');
        const confirmPassword = formEditPassword.querySelector('.form-input[name="confirmPassword"]');

        currentPassword.classList.remove("border-red-500");
        newPassword.classList.remove("border-red-500");
        confirmPassword.classList.remove("border-red-500");

        let formIsValid = true;
        if (currentPassword.value == "") {
            currentPassword.classList.add("border-red-500");
            formIsValid = false;
        }
        if (newPassword.value == "") {
            newPassword.classList.add("border-red-500");
            formIsValid = false;
        }
        if (confirmPassword.value == "" || confirmPassword.value != newPassword.value) {
            confirmPassword.classList.add("border-red-500");
            formIsValid = false;
        }

        if (!formIsValid) return;

        const formData = new FormData(e.target);
        const body = Object.fromEntries(formData);

        const response = await fetch('/user/password', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(body),
        });

        const result = await response.json();

        const message = formEditPassword.querySelector(".message");
        if (result.error) {
            message.innerHTML = result.message;
            message.classList.add("text-red-500");
            message.classList.remove("text-green-500");
        }
        else {
            message.innerHTML = result.message;
            message.classList.remove("text-red-500");
            message.classList.add("text-green-500");
        }

    }
</script>
{{/section}}

<div>
    <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
        <h1 class="text-xl font-semibold text-gray-900">Thông tin cá nhân</h1>
        <button type="button" id="openVerifyModal"
