{{#section "js"}}
<script>
    const modalVerify = document.querySelector("#modalVerify");
    modalVerify.addEventListener("hide.bs.modal", () => {
        const active = document.activeElement;
        if (modalVerify.contains(active)) active.blur();
    });

    const formVerify = document.querySelector("#verifyForm");
    formVerify.onsubmit = async (e) => {
        e.preventDefault();
        const password = document.querySelector('#verifyPassword').value;

        const response = await fetch('/auth/verify-password', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify({ password }),
        });

        const result = await response.json();

        if (result.valid) {
            document.getElementById("passwordError").style.display = 'none';

            const inputField = document.querySelectorAll("[disabled]");
            inputField.forEach((input) => {
                input.removeAttribute('disabled');
            });

            const modal = bootstrap.Modal.getInstance(modalVerify);
            modal.hide();
        } else {
            const message = document.querySelector("#passwordError");
            message.style.display = 'block';
        }
    };

    const validateEmail = (email) => {
        return String(email)
            .toLowerCase()
            .match(
                /^(([^<>()[\]\\.,;:\s@"]+(\.[^<>()[\]\\.,;:\s@"]+)*)|.(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/
            );
    };

    const formEditProfile = document.querySelector("#formEditProfile");
    formEditProfile.onsubmit = async (e) => {
        e.preventDefault();

        const formControl = formEditProfile.querySelectorAll(".form-control");
        let formIsValid = true;
        formControl.forEach((input) => {
            if ((input.getAttribute("name") == "username" || input.getAttribute("name") == "address") && input.value.trim() === "") {
                input.classList.add("invalid");
                formIsValid = false;
                return;
            }
            else if (input.getAttribute("name") == "email" && !validateEmail(input.value)) {
                input.classList.add("invalid");
                formIsValid = false
                return;
            }
            else {
                input.classList.remove("invalid");
            }
        });

        if (!formIsValid) return;
        else {
            const formData = new FormData(e.target);
            const body = Object.fromEntries(formData);

            const response = await fetch('/user/profile', {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(body),
            });

            const result = await response.json();
            console.log(result);
            if (result.status === 0) {
                const message = formEditProfile.querySelector(".message");
                message.classList.remove("text-danger");
                message.classList.add("text-success");
                message.textContent = result.message;
            }
            else if (result.status == 3) {
                if (result.redirectUrl) {
                    window.location.href = result.redirectUrl;
                }
            }
            else {
                const message = formEditProfile.querySelector(".message");
                message.classList.remove("text-success");
                message.classList.add("text-danger");
                message.textContent = result.message;
            }
        }
    }


    const showPasswordBtn = document.querySelectorAll(".show-password-btn");
    showPasswordBtn.forEach((btn) => {
        btn.addEventListener("click", function () {
            const input = btn.closest(".box-password").querySelector("input");

            if (input.type === "password") {
                input.type = "text";
                btn.querySelector("i").classList.replace("bi-eye", "bi-eye-slash");
            } else {
                input.type = "password";
                btn.querySelector("i").classList.replace("bi-eye-slash", "bi-eye");
            }
        });
    });

    const formEditPassword = document.querySelector("#formEditPassword");
    formEditPassword.onsubmit = async (e) => {
        e.preventDefault();

        const currentPassword = formEditPassword.querySelector('.form-control[name="currentPassword"]');
        const newPassword = formEditPassword.querySelector('.form-control[name="password"]');
        const confirmPassword = formEditPassword.querySelector('.form-control[name="confirmPassword"]');

        currentPassword.classList.remove("invalid");
        newPassword.classList.remove("invalid");
        confirmPassword.classList.remove("invalid");

        let formIsValid = true;
        if (currentPassword.value == "") {
            currentPassword.classList.add("invalid");
            formIsValid = false;
        }
        if (newPassword.value == "") {
            newPassword.classList.add("invalid");
            formIsValid = false;
        }
        if (confirmPassword.value == "" || confirmPassword.value != newPassword.value) {
            confirmPassword.classList.add("invalid");
            formIsValid = false;
        }

        if (!formIsValid) return;

        const formData = new FormData(e.target);
        const body = Object.fromEntries(formData);

        const response = await fetch('/user/password', {
            method: 'PATCH',
            headers: {
                'Content-Type': 'application/json',
            },
            body: JSON.stringify(body),
        });

        const result = await response.json();

        const message = formEditPassword.querySelector(".message");
        if (result.error) {
            message.innerHTML = result.message;
            message.classList.add("text-danger");
            message.classList.remove("text-success");
        }
        else {
            message.innerHTML = result.message;
            message.classList.remove("text-danger");
            message.classList.add("text-success");
        }

    }
</script>
{{/section}}

<div class="">
    <p class="fs-4 border-bottom border-gray">Profile information</p>
    <button type="button" class="btn btn-outline-primary mb-4" data-bs-toggle="modal" data-bs-target="#modalVerify">
        <i class="bi bi-pencil-square me-2"></i>
        Edit profile
    </button>

    <div class="modal fade" id="modalVerify" tabindex="-1" aria-labelledby="modalVerifyTitle" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="modalVerifyTitle">Verify Password</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <p>Please enter your password to edit your profile:</p>
                    <form action="/auth/verify-password" method="POST" id="verifyForm">
                        <input type="password" id="verifyPassword" class="form-control" placeholder="Enter password">
                    </form>
                    <div id="passwordError" class="text-danger mt-2" style="display: none;">
                        Incorrect password. Please try again.
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary" form="verifyForm" id="verifyBtn">Verify</button>
                </div>
            </div>
        </div>
    </div>

    <form class="form row row-cols-2 g-3" id="formEditProfile">
        <div class="col">
            <p class="mb-0">Full name</p>
            <input type="text" class="form-control" name="username" value="{{authUser.username}}" autocomplete="name"
                disabled>
        </div>

        <div class="col">
            <p class="mb-0">Email</p>
            <input type="text" class="form-control" name="email" value="{{authUser.email}}" autocomplete="email"
                disabled>
        </div>

        <div class="col">
            <p class="mb-0">Address</p>
            <input type="text" class="form-control" name="address" value="{{authUser.address}}"
                autocomplete="street-address" disabled>
        </div>

        <div class="col">
            <p class="mb-0">birthday</p>
            <input type="date" class="form-control" name="birthday" value="{{formatDate authUser.birthday}}"
                autocomplete="bday" disabled>
        </div>

        <div class="col"></div>
        <div class="col d-flex align-items-center justify-content-between">
            <button class="btn btn-outline-secondary" disabled>Update</button>
            <p class="text-danger mb-0 message"></p>
        </div>
    </form>

    <form id="formEditPassword" class="row row-cols-2 g-3 mt-2">
        <div class="col">
            <p class="mb-0">Current password</p>
            <div class="d-flex box-password">
                <input type="password" class="form-control" name="currentPassword" autocomplete="off" disabled>
                <button class="show-password-btn btn btn-bg-primary"><i class="bi bi-eye"></i></button>
            </div>
        </div>

        <div class="col"></div>

        <div class="col">
            <p class="mb-0">Password</p>
            <div class="d-flex box-password">
                <input type="password" class="form-control" name="password" autocomplete="off" disabled>
                <button class="show-password-btn btn btn-bg-primary"><i class="bi bi-eye"></i></button>
            </div>
        </div>

        <div class="col">
            <p class="mb-0">Confirm password</p>
            <div class="d-flex box-password">
                <input type="password" class="form-control" name="confirmPassword" autocomplete="off" disabled>
                <button class="show-password-btn btn btn-bg-primary"><i class="bi bi-eye"></i></button>
            </div>
        </div>
        <div class="col d-flex align-items-center justify-content-between">
            <button class="btn btn-outline-secondary" disabled>Change password</button>
            <p class="text-danger mb-0 message"></p>
        </div>
    </form>
</div>