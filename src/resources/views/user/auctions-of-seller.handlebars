{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days} ngày `;
            if (hours > 0) str += ` ${hours} giờ `;
            if (minutes > 0) str += ` ${minutes} phút`;
            return str;
        }

        let str = "";
        if (hours > 0) str += `${hours} giờ `;
        if (minutes > 0) str += `${minutes} phút `;
        str += `${seconds} giây`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);
        })
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    let selectedAuctionId = null;
    let highestBidderId = null;

    const modal = document.getElementById("assessBidderModal");
    const modalOverlay = document.getElementById("modalOverlay");
    const text = document.getElementById("assessBidderText");
    const contentRating = document.querySelector("#content-rating");
    const closeModalBtns = document.querySelectorAll(".close-modal");

    function openModal(button) {
        selectedAuctionId = button.dataset.auctionId;
        highestBidderId = button.dataset.highestBidderId;
        const highestBidderName = button.dataset.highestBidderName;
        text.textContent = `Bạn đánh giá như thế nào về người mua ${highestBidderName}?`;

        modal.classList.remove("hidden");
        modalOverlay.classList.remove("hidden");
        document.body.style.overflow = "hidden";
    }

    function closeModal() {
        modal.classList.add("hidden");
        modalOverlay.classList.add("hidden");
        document.body.style.overflow = "";
    }

    document.querySelectorAll(".open-rating-modal").forEach(btn => {
        btn.addEventListener("click", () => openModal(btn));
    });

    modalOverlay.addEventListener("click", closeModal);
    closeModalBtns.forEach(btn => btn.addEventListener("click", closeModal));

    document.querySelectorAll(".rate-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            if (contentRating.value == "") {
                contentRating.classList.add("border-red-500");
                e.preventDefault();
                return;
            }

            const rating = btn.dataset.rating == "good" ? 1 : -1;

            const res = await fetch(`http://localhost:3000/user/ratings/${highestBidderId}`, {
                method: "post",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    auction_id: selectedAuctionId,
                    rating,
                    content: contentRating.value
                })
            });

            closeModal();
            location.reload();
        });
    });

    contentRating.addEventListener("input", () => {
        contentRating.classList.remove("border-red-500");
    });
</script>
{{/section}}

<div>
    <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
        <h1 class="text-xl font-semibold text-gray-900">Đấu giá của tôi</h1>
        <a href="/auctions/create"
            class="inline-flex items-center gap-2 px-4 py-2 bg-primary-500 hover:bg-primary-600 text-white rounded-xl font-medium transition">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6">
                </path>
            </svg>
            Đăng mới
        </a>
    </div>

    <div class="bg-gradient-to-r from-primary-50 to-primary-100 rounded-xl p-5 mb-6">
        <div class="text-center">
            <span class="text-gray-600">Tổng số đấu giá đã đăng</span>
            <p class="text-3xl font-bold text-primary-600 mt-1">{{auctions.length}}</p>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-h-[400px] overflow-y-auto pr-2">
        {{#each auctions}}
        <div
            class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-primary-200 transition-all">
            <div class="aspect-[4/3] overflow-hidden">
                <img src="{{imageOrPlaceholder this.mainImage.url}}"
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                    alt="{{this.name}}" onerror="this.onerror=null; this.src='/images/placeholder.webp';">
            </div>
            <div class="p-4">
                <h3 class="font-medium text-gray-900 line-clamp-1 mb-3">{{this.name}}</h3>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Giá hiện tại:</span>
                        <span class="font-semibold text-primary-500">{{formatNumber this.current_price}}
                            <sup>đ</sup></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Giá tối đa:</span>
                        <span class="font-medium text-gray-900">{{formatNumber this.max_price}}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Còn lại:</span>
                        <span class="font-medium text-orange-500 remaining-time" data-end-time="{{this.end_at}}"></span>
                    </div>
                </div>
                <div class="flex gap-2 mt-4">
                    <a href="/auctions/{{this.id}}"
                        class="flex-1 py-2 px-3 text-center border border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-white rounded-lg font-medium transition text-sm">
                        Xem
                    </a>
                    <a href="/auctions/edit/{{this.id}}"
                        class="flex-1 py-2 px-3 text-center border border-gray-300 text-gray-700 hover:bg-gray-100 rounded-lg font-medium transition text-sm">
                        Sửa
                    </a>
                    {{#if (isOver this.end_at)}}
                    {{#if this.highestBidder}}
                    {{#unless (include ../listRated this.id)}}
                    <button type="button"
                        class="open-rating-modal flex-1 py-2 px-3 text-center bg-yellow-100 text-yellow-700 hover:bg-yellow-200 rounded-lg font-medium transition text-sm"
                        data-auction-id="{{this.id}}" data-highest-bidder-id="{{this.highestBidder.id}}"
                        data-highest-bidder-name="{{this.highestBidder.username}}">
                        Đánh giá
                    </button>
                    {{/unless}}
                    {{/if}}
                    {{/if}}
                </div>
            </div>
        </div>
        {{else}}
        <div class="col-span-full text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10">
                </path>
            </svg>
            <p class="text-gray-500">Bạn chưa đăng đấu giá nào</p>
            <a href="/auctions/create"
                class="inline-flex items-center gap-2 mt-4 text-primary-500 hover:text-primary-600 font-medium">
                Đăng đấu giá ngay
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
        {{/each}}
    </div>
</div>

<div id="modalOverlay" class="hidden fixed inset-0 bg-black/50 z-50"></div>
<div id="assessBidderModal"
    class="hidden fixed top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-white rounded-2xl shadow-xl z-50 w-full max-w-md p-6">
    <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold text-gray-900">Đánh giá người mua</h3>
        <button class="close-modal text-gray-400 hover:text-gray-600">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
    <p class="text-gray-600 mb-4 text-center" id="assessBidderText"></p>

    <input type="text"
        class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-primary-500 focus:border-primary-500 transition mb-4"
        name="content" id="content-rating" placeholder="Để lại nhận xét...">

    <div class="flex justify-center gap-4">
        <button type="button"
            class="rate-btn flex items-center gap-2 px-6 py-3 bg-green-500 hover:bg-green-600 text-white rounded-xl font-medium transition"
            data-rating="good">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M14 10h4.764a2 2 0 011.789 2.894l-3.5 7A2 2 0 0115.263 21h-4.017c-.163 0-.326-.02-.485-.06L7 20m7-10V5a2 2 0 00-2-2h-.095c-.5 0-.905.405-.905.905 0 .714-.211 1.412-.608 2.006L7 11v9m7-10h-2M7 20H5a2 2 0 01-2-2v-6a2 2 0 012-2h2.5">
                </path>
            </svg>
            Tốt
        </button>
        <button type="button"
            class="rate-btn flex items-center gap-2 px-6 py-3 bg-red-500 hover:bg-red-600 text-white rounded-xl font-medium transition"
            data-rating="bad">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M10 14H5.236a2 2 0 01-1.789-2.894l3.5-7A2 2 0 018.736 3h4.018a2 2 0 01.485.06l3.76.94m-7 10v5a2 2 0 002 2h.095c.5 0 .905-.405.905-.905 0-.714.211-1.412.608-2.006L17 13V4m-7 10h2m5-10h2a2 2 0 012 2v6a2 2 0 01-2 2h-2.5">
                </path>
            </svg>
            Không tốt
        </button>
    </div>

    <div class="mt-6 text-center">
        <button type="button" class="close-modal text-gray-500 hover:text-gray-700 font-medium">Hủy</button>
    </div>
</div>