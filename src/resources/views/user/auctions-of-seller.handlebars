{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "It's over.";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days}d: `;
            if (hours > 0) str += ` ${hours}h: `;
            if (minutes > 0) str += ` ${minutes}m`;
            return str;
        }

        // <= 1 ngày -> hiển thị giây
        let str = "";
        if (hours > 0) str += `${hours}h: `;
        if (minutes > 0) str += `${minutes}m: `;
        str += `${seconds}s`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);
        })
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
<script>
    let selectedAuctionId = null;
    let highestBidderId = null;

    const modal = document.getElementById("assessSellerModal");
    const text = document.getElementById("assessSellerText");

    modal.addEventListener("show.bs.modal", (event) => {
        const button = event.relatedTarget;

        selectedAuctionId = button.dataset.auctionId;
        highestBidderId = button.dataset.highestBidderId;

        const highestBidderName = button.dataset.highestBidderName;

        text.textContent = `How would you rate your experience with seller ${highestBidderName}?`;
    });

    document.querySelectorAll(".rate-btn").forEach(btn => {
        btn.addEventListener("click", async (e) => {
            e.currentTarget.blur();
            const rating = btn.dataset.rating == "good" ? 1 : -1;

            const res = await fetch(`http://localhost:3000/user/ratings/${highestBidderId}`, {
                method: "post",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    auction_id: selectedAuctionId,
                    rating
                })
            })

            bootstrap.Modal.getInstance(modal).hide();
        });
    });
</script>
{{/section}}

<div class="">
    <p class="fs-4 border-bottom border-gray">My auctions</p>

    <div class="row mx-4 py-2 border-bottom border-gray">
        <div class="col d-flex flex-column text-center">
            <span class="text-secondary fs-5">Number of auctions</span>
            <span class="fw-semibold fs-4">{{auctions.length}}</span>
        </div>
    </div>


    <div class="row row-cols-3 g-3 mt-2" style="max-height: 400px; overflow-y:scroll;">

        {{#each auctions}}
        <div class="col">
            <div class="card h-100">
                <img src="{{this.mainImage.url}}" class="card-img-top card-product-img" alt="Laptop"
                    style="height: 200px; object-fit: contain;">
                <div class="card-body card-product-info">
                    <h5 class="card-title">{{this.name}}</h5>
                    <div class="d-flex justify-content-between">
                        <p class="mb-1">Current price:</p>
                        <p class="mb-1">{{formatNumber this.current_price}} <sup>đ</sup></p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <p class="mb-1">Your max price:</p>
                        <p class="mb-1">{{formatNumber this.max_price}}</p>
                    </div>
                    <div class="d-flex justify-content-between">
                        <p class="mb-1">Remaining:</p>
                        <p class="mb-1 remaining-time" data-end-time="{{this.end_at}}"></p>
                    </div>
                    <div class="d-flex">
                        <a href="/auctions/{{this.id}}" class="btn btn-outline-primary w-100 me-2">View</a>
                        <a href="/auctions/edit/{{this.id}}" class="btn btn-outline-secondary w-100">Edit</a>
                        {{#if (isOver this.end_at)}}
                        {{#if this.highestBidder}}
                        <button type="button" class="btn btn-outline-secondary w-100 ms-2" data-bs-toggle="modal"
                            data-bs-target="#assessSellerModal" data-auction-id="{{this.id}}"
                            data-highest-bidder-id="{{this.highestBidder.id}}"
                            data-highest-bidder-name="{{this.highestBidder.username}}">
                            Rating
                        </button>
                        {{/if}}
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>
        {{/each}}

        <div class="modal fade" id="assessSellerModal" tabindex="-1" aria-labelledby="assessSellerModalLabel"
            aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">

                    <div class="modal-header">
                        <h5 class="modal-title" id="assessSellerModalLabel">
                            Assess Seller
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body text-center">
                        <p class="mb-4" id="assessSellerText"></p>

                        <div class="d-flex justify-content-center gap-3">
                            <button type="button" class="btn btn-success px-4 rate-btn" data-rating="good">
                                <i class="bi bi-hand-thumbs-up me-1"></i>
                                Good
                            </button>

                            <button type="button" class="btn btn-danger px-4 rate-btn" data-rating="bad">
                                <i class="bi bi-hand-thumbs-down me-1"></i>
                                Bad
                            </button>
                        </div>
                    </div>

                    <div class="modal-footer justify-content-center">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            Cancel
                        </button>
                    </div>

                </div>
            </div>
        </div>


    </div>

</div>