{{#section "js"}}
<script>
    const remaininTimes = document.querySelectorAll(".remaining-time");

    function formatRemainingTime(ms) {
        if (ms <= 0) return "Đã kết thúc";

        let diff = ms;

        const days = Math.floor(diff / (1000 * 60 * 60 * 24));
        diff -= days * 24 * 60 * 60 * 1000;
        const hours = Math.floor(diff / (1000 * 60 * 60));
        diff -= hours * 60 * 60 * 1000;
        const minutes = Math.floor(diff / (1000 * 60));
        diff -= minutes * 60 * 1000;

        const seconds = Math.floor(diff / 1000);

        if (days > 0) {
            let str = `${days} ngày `;
            if (hours > 0) str += ` ${hours} giờ `;
            if (minutes > 0) str += ` ${minutes} phút`;
            return str;
        }

        let str = "";
        if (hours > 0) str += `${hours} giờ `;
        if (minutes > 0) str += `${minutes} phút `;
        str += `${seconds} giây`;

        return str.trim();
    }

    function updateRemainingTime() {
        remaininTimes.forEach(function (element) {
            const end = new Date(element.getAttribute("data-end-time"));
            const now = new Date();
            const diff = end - now;
            element.textContent = formatRemainingTime(diff);
        })
    }

    updateRemainingTime();

    setInterval(updateRemainingTime, 1000);
</script>
{{/section}}

<div>
    <!-- Header -->
    <div class="flex items-center justify-between border-b border-gray-200 pb-4 mb-6">
        <h1 class="text-xl font-semibold text-gray-900">Lượt đấu giá của tôi</h1>
    </div>

    <!-- Stats -->
    <div class="bg-gradient-to-r from-primary-50 to-primary-100 rounded-xl p-5 mb-6">
        <div class="text-center">
            <span class="text-gray-600">Số đấu giá đang tham gia</span>
            <p class="text-3xl font-bold text-primary-600 mt-1">{{auctions.length}}</p>
        </div>
    </div>

    <!-- Auctions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 max-h-[400px] overflow-y-auto pr-2">
        {{#each auctions}}
        <div
            class="group bg-white rounded-xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-primary-200 transition-all">
            <div class="aspect-[4/3] overflow-hidden">
                <img src="{{imageOrPlaceholder this.mainImage.url}}"
                    class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-300"
                    alt="{{this.name}}" onerror="this.onerror=null; this.src='/images/placeholder.webp';">
            </div>
            <div class="p-4">
                <h3 class="font-medium text-gray-900 line-clamp-1 mb-3">{{this.name}}</h3>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between">
                        <span class="text-gray-500">Giá hiện tại:</span>
                        <span class="font-semibold text-primary-500">{{formatNumber this.current_price}}
                            <sup>đ</sup></span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Giá đặt tối đa:</span>
                        <span class="font-medium text-gray-900">{{formatNumber this.max_price}}</span>
                    </div>
                    <div class="flex justify-between">
                        <span class="text-gray-500">Còn lại:</span>
                        <span class="font-medium text-orange-500 remaining-time" data-end-time="{{this.end_at}}"></span>
                    </div>
                </div>
                <a href="/auctions/{{this.id}}"
                    class="block mt-4 py-2.5 px-4 text-center border border-primary-500 text-primary-500 hover:bg-primary-500 hover:text-white rounded-xl font-medium transition">
                    Xem chi tiết
                </a>
            </div>
        </div>
        {{else}}
        <div class="col-span-full text-center py-12">
            <svg class="w-16 h-16 mx-auto text-gray-300 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z">
                </path>
            </svg>
            <p class="text-gray-500">Bạn chưa tham gia đấu giá nào</p>
            <a href="/auctions"
                class="inline-flex items-center gap-2 mt-4 text-primary-500 hover:text-primary-600 font-medium">
                Khám phá đấu giá
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
            </a>
        </div>
        {{/each}}
    </div>
</div>