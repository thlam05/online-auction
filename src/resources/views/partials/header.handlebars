<div id="header">
    <ul class="nav nav-pills p-2">
        <li class="container d-flex justify-content-between list-unstyled">

            <ul class="nav d-flex">
                <li class="nav-item">
                    <a class="nav-link" href="/">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auctions">Auctions</a>
                </li>
            </ul>

            <form action="/auctions/search" method="GET" class="d-flex">
                <input type="text" class="form-control me-3" placeholder="Search" name="q">
                <button class="btn btn-outline-secondary">
                    <i class="bi bi-search"></i>
                </button>
            </form>

            <ul class="nav d-flex">
                {{#if isAuthenticated}}
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" id="dropdownMenuButton1" role="button"
                        data-bs-toggle="dropdown" aria-expanded="false">
                        Hello, {{authUser.username}}!
                    </a>

                    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
                        <li class="nav-item">
                            <a class="dropdown-item" href="/user/watch-list">
                                <i class="bi bi-cart pe-2"></i>
                                Watch list
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/user/profile">
                                <i class="bi bi-person pe-2"></i>
                                Profile
                            </a>
                        </li>
                        {{#if (isBidder authUser.permission)}}
                        <li>
                            <a class="dropdown-item" href="/user/upgrade-seller">
                                <i class="bi bi-shop pe-2"></i>
                                Upgrade to seller
                            </a>
                        </li>
                        {{/if}}
                        {{#if (isSeller authUser.permission)}}
                        <li>
                            <a class="dropdown-item" href="/auctions/create">
                                <i class="bi bi-plus-square pe-2"></i>
                                Post auction
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item" href="/user/auctions">
                                <i class="bi bi-collection pe-2"></i>
                                My auctions
                            </a>
                        </li>
                        {{/if}}
                        <li>
                            <form action="/auth/logout" method="POST" class="">
                                <button type="submit" class="dropdown-item"><i class="bi bi-box-arrow-right pe-2"></i>
                                    Log out</button>
                            </form>
                        </li>
                    </ul>
                </li>
                {{else}}
                <li class="nav-item border-end border-secondary">
                    <a class="nav-link" href="/auth/signin">Sign in</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/auth/signup">Sign up</a>
                </li>
                {{/if}}
            </ul>

        </li>
    </ul>
</div>