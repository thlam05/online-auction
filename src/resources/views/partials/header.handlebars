<!-- Header -->
<header class="sticky top-0 z-50 bg-primary-500 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16 gap-4">

            <!-- Logo & Nav -->
            <div class="flex items-center gap-8">
                <!-- Logo -->
                <a href="/" class="flex items-center hover:opacity-90 transition-opacity">
                    <img src="/images/logo-white.svg" alt="bidhub" class="h-12">
                </a>

                <!-- Main Nav -->
                <nav class="hidden md:flex items-center gap-1">
                    <a href="/"
                        class="px-4 py-2 text-white/90 hover:text-white hover:bg-white/10 rounded-lg font-medium transition-all">
                        Trang chủ
                    </a>
                    <a href="/auctions"
                        class="px-4 py-2 text-white/90 hover:text-white hover:bg-white/10 rounded-lg font-medium transition-all">
                        Đấu giá
                    </a>
                </nav>
            </div>

            <!-- Search Bar -->
            <div class="flex-1 max-w-xl">
                <form action="/auctions/search" method="GET" class="relative">
                    <input type="text" name="q" placeholder="Tìm kiếm sản phẩm..."
                        class="w-full pl-4 pr-12 py-2.5 bg-white rounded-full text-gray-900 placeholder-gray-500 focus:outline-none focus:ring-2 focus:ring-white/50 transition-all">
                    <button type="submit"
                        class="absolute right-1 top-1/2 -translate-y-1/2 p-2 bg-primary-500 hover:bg-primary-600 text-white rounded-full transition-colors">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Right Actions -->
            <div class="flex items-center gap-2">
                {{#if isAuthenticated}}
                <!-- Watch List -->
                <a href="/user/watch-list"
                    class="p-2 text-white/90 hover:text-white hover:bg-white/10 rounded-lg transition-all"
                    title="Danh sách yêu thích">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                </a>

                <!-- User Dropdown -->
                <div class="hs-dropdown relative inline-flex">
                    <button id="hs-dropdown-user" type="button"
                        class="hs-dropdown-toggle flex items-center gap-2 px-3 py-2 text-white hover:bg-white/10 rounded-lg transition-all">
                        <div class="w-8 h-8 bg-white/20 rounded-full flex items-center justify-center">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                            </svg>
                        </div>
                        <span class="hidden sm:block font-medium">{{authUser.username}}</span>
                        <svg class="w-4 h-4 hs-dropdown-open:rotate-180 transition-transform" fill="none"
                            stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                        </svg>
                    </button>

                    <div class="hs-dropdown-menu transition-[opacity,margin] duration-200 hs-dropdown-open:opacity-100 opacity-0 hidden min-w-48 bg-white shadow-xl rounded-xl p-2 mt-2 border border-gray-100"
                        aria-labelledby="hs-dropdown-user">
                        <div class="px-4 py-3 border-b border-gray-100">
                            <p class="text-sm text-gray-500">Đăng nhập với</p>
                            <p class="font-semibold text-gray-900 truncate">{{authUser.email}}</p>
                        </div>

                        <div class="py-2 space-y-1">
                            <a href="/user/profile"
                                class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                                </svg>
                                Hồ sơ cá nhân
                            </a>
                            <a href="/user/watch-list"
                                class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                                </svg>
                                Danh sách yêu thích
                            </a>
                            <a href="/user/bids"
                                class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M9 5H7a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                                </svg>
                                Lịch sử đấu giá
                            </a>
                            {{#if (isBidder authUser.permission)}}
                            <a href="/user/upgrade-seller"
                                class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                                </svg>
                                Nâng cấp Seller
                            </a>
                            {{/if}}
                            {{#if (isSeller authUser.permission)}}
                            <a href="/auctions/create"
                                class="flex items-center gap-3 px-4 py-2 text-primary-500 hover:bg-primary-50 rounded-lg transition-colors">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M12 6v6m0 0v6m0-6h6m-6 0H6" />
                                </svg>
                                Đăng sản phẩm
                            </a>
                            <a href="/user/auctions"
                                class="flex items-center gap-3 px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg transition-colors">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                                </svg>
                                Sản phẩm của tôi
                            </a>
                            {{/if}}
                        </div>

                        <div class="border-t border-gray-100 pt-2">
                            <form action="/auth/logout" method="POST">
                                <button type="submit"
                                    class="w-full flex items-center gap-3 px-4 py-2 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
                                    </svg>
                                    Đăng xuất
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
                {{else}}
                <!-- Login/Register -->
                <a href="/auth/signin"
                    class="px-4 py-2 text-white/90 hover:text-white hover:bg-white/10 rounded-lg font-medium transition-all">
                    Đăng nhập
                </a>
                <a href="/auth/signup"
                    class="px-4 py-2 bg-white text-primary-500 hover:bg-gray-100 rounded-lg font-medium transition-all">
                    Đăng ký
                </a>
                {{/if}}

                <!-- Mobile Menu Button -->
                <button type="button" class="md:hidden p-2 text-white hover:bg-white/10 rounded-lg transition-all"
                    data-hs-overlay="#mobile-menu">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>
            </div>
        </div>
    </div>
</header>

<!-- Mobile Menu Sidebar -->
<div id="mobile-menu"
    class="hs-overlay hidden fixed inset-0 z-[80] overflow-x-hidden overflow-y-auto pointer-events-none">
    <div
        class="hs-overlay-open:translate-x-0 -translate-x-full transition-all duration-300 transform fixed top-0 start-0 bottom-0 z-[80] w-64 bg-white border-e pointer-events-auto">
        <div class="flex justify-between items-center py-3 px-4 border-b">
            <h3 class="font-bold text-gray-800">Menu</h3>
            <button type="button"
                class="flex items-center justify-center w-8 h-8 text-gray-400 hover:bg-gray-100 rounded-lg"
                data-hs-overlay="#mobile-menu">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
            </button>
        </div>
        <nav class="p-4 space-y-2">
            <a href="/" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Trang chủ</a>
            <a href="/auctions" class="block px-4 py-2 text-gray-700 hover:bg-gray-100 rounded-lg">Đấu giá</a>
        </nav>
    </div>
</div>