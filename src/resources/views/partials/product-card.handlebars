<a href="/auctions/{{this.id}}" class="product-card group bg-white rounded-2xl border border-gray-200 overflow-hidden hover:shadow-lg hover:border-primary-200 transition-all flex flex-col">
    <div class="relative overflow-hidden bg-white">
        <img src="{{imageOrPlaceholder this.mainImage.url}}" alt="{{this.name}}" class="product-card-img group-hover:scale-105 transition-transform duration-300"
            onerror="this.onerror=null; this.src='/images/placeholder.webp';">
        {{#if this.badgeType}}
        <div class="absolute top-2 left-2">
            {{#if (equal this.badgeType "danger")}}
            <span class="badge badge-danger flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {{this.badgeText}}
            </span>
            {{else if (equal this.badgeType "warning")}}
            <span class="badge badge-warning flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
                </svg>
                {{this.badgeText}}
            </span>
            {{else if (equal this.badgeType "success")}}
            <span class="badge badge-success flex items-center gap-1">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2" />
                </svg>
                {{this.badgeText}}
            </span>
            {{else if (equal this.badgeType "primary")}}
            <span class="badge badge-primary">{{this.badgeText}}</span>
            {{/if}}
        </div>
        {{/if}}
    </div>
    <div class="product-card-body">
        <h3 class="product-card-title">{{this.name}}</h3>
        {{#if this.showTags}}
        {{#if this.badgeType}}
        <div class="flex flex-wrap gap-2 mb-3">
            {{#if (equal this.badgeType "danger")}}
            <span class="badge badge-danger text-xs">{{this.badgeText}}</span>
            {{else if (equal this.badgeType "warning")}}
            <span class="badge badge-warning text-xs">{{this.badgeText}}</span>
            {{else if (equal this.badgeType "success")}}
            <span class="badge badge-success text-xs">{{this.badgeText}}</span>
            {{else if (equal this.badgeType "primary")}}
            <span class="badge badge-primary text-xs">{{this.badgeText}}</span>
            {{/if}}
        </div>
        {{/if}}
        {{/if}}
        <div class="space-y-2 text-sm {{#if this.showBidder}}mb-4{{else}}mb-4{{/if}}">
            <div class="flex justify-between items-center">
                <span class="text-gray-500">Giá hiện tại:</span>
                <span class="product-card-price">{{formatNumber this.current_price}}<sup
                        class="text-xs">đ</sup></span>
            </div>
            {{#if this.showBidder}}
            <div class="flex justify-between items-center">
                <span class="text-gray-500">Người đặt:</span>
                <span class="text-gray-700 font-medium">{{this.highestBidder.username}}</span>
            </div>
            {{/if}}
            {{#if this.showDate}}
            <div class="flex justify-between items-center">
                <span class="text-gray-500">Ngày đăng:</span>
                <span class="text-gray-700">{{formatDate this.start_at}}</span>
            </div>
            {{/if}}
            <div class="flex justify-between items-center">
                <span class="text-gray-500">Còn lại:</span>
                <span class="remaining-time font-semibold text-gray-900"
                    data-end-time="{{this.end_at}}">--:--:--</span>
            </div>
        </div>

        <span
            class="w-full inline-flex justify-center items-center gap-2 py-2.5 px-4 bg-primary-500 text-white font-medium rounded-lg group-hover:bg-primary-600 transition-colors">
            Đấu giá ngay
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                    d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
        </span>
    </div>
</a>
