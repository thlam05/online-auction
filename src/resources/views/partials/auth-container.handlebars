<div class="min-h-[calc(100vh-80px)] flex">
    <!-- Left - Brand Section with Banner Image -->
    <div class="hidden lg:flex lg:w-1/2 p-6 overflow-hidden relative">
        <div class="w-full h-full rounded-3xl overflow-hidden relative">
            <img src="/images/login-banner.webp" alt="login banner"
                class="w-full h-full object-cover object-center absolute inset-0">
        </div>
    </div>

    <!-- Right - Form Section -->
    <div class="flex-1 flex flex-col">
        <!-- Top navigation -->
        <div class="flex justify-between items-center p-6">
            <div class="lg:hidden flex flex-col items-center gap-2">
                <img src="/images/logo.svg" alt="bidhub logo" class="w-12 h-12">
            </div>
            <a href="{{navigationLink}}"
                class="text-sm font-medium text-foreground hover:text-primary-500 transition-colors ml-auto">
                {{navigationText}}
            </a>
        </div>

        <!-- Form container -->
        <div class="flex-1 flex items-center justify-center px-6 pb-12">
            <div class="w-full max-w-[350px] space-y-6">
                {{> @partial-block}}
            </div>
        </div>
    </div>
</div>